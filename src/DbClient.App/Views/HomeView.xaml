<UserControl x:Class="DbClient.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:DbClient.App"
             xmlns:controls="clr-namespace:DbClient.App.Controls"
             xmlns:models="clr-namespace:DbClient.Core.Models;assembly=DbClient.Core"
             xmlns:themes="clr-namespace:DbClient.App.Themes"
             xmlns:views="clr-namespace:DbClient.App.Views"
             xmlns:vm="clr-namespace:DbClient.ViewModels;assembly=DbClient.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Background="{DynamicResource Brush.Bg.App}">
    <UserControl.Resources>
        <ContextMenu x:Key="ConnectionMenu" x:Shared="False">
            <MenuItem Header="Connect" Command="{Binding ConnectCommand}" InputGestureText="Enter" />
            <MenuItem Header="Edit…" Command="{Binding EditCommand}" InputGestureText="F2" />
            <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" InputGestureText="Ctrl+D" />
            <MenuItem Header="Test connection" Command="{Binding TestConnectionCommand}" />
            <Separator />
            <MenuItem Header="Copy password" Command="{Binding CopyPasswordCommand}" />
            <Separator />
            <MenuItem Header="Delete…" Command="{Binding DeleteCommand}" />
        </ContextMenu>
        <Geometry x:Key="Ico.Database">M2.5,3.5 C2.5,1.5 11.5,1.5 11.5,3.5 L11.5,10.5 C11.5,12.5 2.5,12.5 2.5,10.5 Z M2.5,3.5 C2.5,5.5 11.5,5.5 11.5,3.5 M2.5,7 C2.5,9 11.5,9 11.5,7</Geometry>

        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Padding" Value="8,2,8,3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.FontSize" Value="13" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>

        <Style x:Key="ActionCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Bd">
                            <Border CornerRadius="12" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                            <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Strong}" Opacity="0"
                                    themes:Fade.Visible="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="23,19" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource Button.Link}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="22,0,0,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        </Style>

        <Style x:Key="GroupRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring.Inset}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="38" Background="Transparent">
                            <Border CornerRadius="8" Background="{DynamicResource Brush.Bg.Hover}" Opacity="0" themes:Fade.Visible="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border CornerRadius="8" Background="{DynamicResource Brush.Accent.Subtle}" Opacity="0" themes:Fade.Visible="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
                            <DockPanel Margin="14,0" VerticalAlignment="Center">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <Grid Width="9" Height="9" Margin="0,1,12,0">
                                    <Ellipse Fill="{DynamicResource Brush.Text.Tertiary}" />
                                    <Ellipse Fill="{Binding Color, Converter={x:Static app:Converters.HexToBrush}}" />
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecentCard" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRowMouseDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                        <Border CornerRadius="14" BorderThickness="1" Background="{DynamicResource Brush.Bg.Card}" BorderBrush="{DynamicResource Brush.Border.Subtle}" />
                        <Border x:Name="Hover" CornerRadius="14" BorderThickness="1" Opacity="0" BorderBrush="{DynamicResource Brush.Border.Strong}" />
                        <Border x:Name="Sel" CornerRadius="14" BorderThickness="1" Opacity="0"
                                Background="{DynamicResource Brush.Accent.Subtle}" BorderBrush="{DynamicResource Brush.Accent}" />
                        <Border Padding="18,16,18,14">
                            <StackPanel>
                                <DockPanel>
                                    <controls:EngineBadge Kind="{Binding Kind}" Width="44" Height="44" />
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Kind, Converter={x:Static app:Converters.KindName}}" Margin="0,2,0,0" FontSize="13"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Converter={x:Static app:Converters.ProfileAddress}}" Margin="0,16,0,14"
                                           FontFamily="{DynamicResource Font.Mono}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" Padding="0,12,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource Button.Ghost}" Padding="12,5" IsTabStop="False"
                                                Background="{DynamicResource Brush.Bg.Hover}"
                                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Connect (Enter)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Connect" FontWeight="SemiBold" />
                                                <TextBlock Text="&#xE049;" Style="{DynamicResource Text.Icon}" FontSize="10" Margin="8,1,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LastUsed, Converter={x:Static app:Converters.RelativeTime}}" Margin="9,0,0,0" FontSize="13"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring.Inset}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Converter={x:Static app:Converters.ProfileSubtitle}}" />
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRowMouseDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" Background="Transparent">
                            <Grid MinHeight="66">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="2.6*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Hover" Grid.ColumnSpan="5" Opacity="0" Background="{DynamicResource Brush.Bg.Hover}" />
                                <Grid x:Name="Sel" Grid.ColumnSpan="5" Opacity="0">
                                    <Border Background="{DynamicResource Brush.Accent.Subtle}" />
                                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{DynamicResource Brush.Accent}" />
                                </Grid>
                                <DockPanel Margin="20,0,12,0" VerticalAlignment="Center">
                                    <controls:EngineBadge Kind="{Binding Kind}" Width="36" Height="36" />
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Kind, Converter={x:Static app:Converters.KindName}}" Margin="0,1,0,0" FontSize="13"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Converter={x:Static app:Converters.ProfileAddress}}" Margin="0,0,16,0"
                                           VerticalAlignment="Center" FontFamily="{DynamicResource Font.Mono}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Converter={x:Static app:Converters.ProfileLocation}}" />
                                <Border x:Name="Tag" Grid.Column="2" HorizontalAlignment="Left" Padding="10,2,10,3" CornerRadius="11" BorderThickness="1"
                                        VerticalAlignment="Center" BorderBrush="{Binding Color, Converter={x:Static app:Converters.HexToBrush}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="TagDot" Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={x:Static app:Converters.HexToBrush}}" />
                                        <TextBlock x:Name="TagText" Text="{Binding Color, Converter={x:Static app:Converters.TagName}}" FontSize="12.5" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding LastUsed, Converter={x:Static app:Converters.RelativeTime}}" FontSize="13.5"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <StackPanel x:Name="Actions" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0"
                                            VerticalAlignment="Center" Visibility="Hidden" themes:Fade.OnShow="True">
                                    <Button Content="Edit" Padding="14,6" IsTabStop="False"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip="Edit (F2)" />
                                    <Button Content="Connect" Padding="16,6" Margin="8,0,0,0" IsTabStop="False" Style="{DynamicResource Button.Primary}"
                                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip="Connect (Enter)" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Color}" Value="{x:Null}">
                                <Setter TargetName="Tag" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                <Setter TargetName="TagDot" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TagText" Property="Text" Value="Untagged" />
                                <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarItem" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        </Style>

        <Style x:Key="EditorRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring.Inset}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnEditorRowClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border CornerRadius="10" Background="{DynamicResource Brush.Bg.Hover}" Opacity="0" themes:Fade.Visible="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border CornerRadius="10" BorderThickness="1" Background="{DynamicResource Brush.Accent.Subtle}" BorderBrush="{DynamicResource Brush.Border.Default}"
                                    Opacity="0" themes:Fade.Visible="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Grid Margin="13,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <controls:EngineBadge Kind="{Binding Kind}" Width="32" Height="32" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Converter={x:Static app:Converters.ProfileLocation}}" Margin="0,3,0,0"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="40,9,12,9" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <DataTemplate DataType="{x:Type vm:ConnectionEditorViewModel}">
            <views:ConnectionEditorView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid themes:Fade.OnShow="True">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Connections.Count}" Value="0" />
                                <Condition Binding="{Binding EditorPage}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel MaxWidth="860" Margin="40,40" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="74" Height="74" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="0,22,0,0" Text="Welcome to Qorra" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"
                               FontFamily="{DynamicResource Font.Display}" />

                    <Button Margin="0,38,0,14" Style="{StaticResource ActionCard}" Command="{Binding NewCommand}"
                            Background="{DynamicResource Brush.Accent.Subtle}" BorderBrush="{DynamicResource Brush.Accent}"
                            AutomationProperties.Name="New connection">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Keycap}" Background="{DynamicResource Brush.Accent.Subtle}">
                                <TextBlock Text="Ctrl N" />
                            </Border>
                            <Border Style="{StaticResource IconTile}" Width="52" Height="52" Background="{DynamicResource Brush.Accent}">
                                <TextBlock Text="&#xE13D;" Style="{DynamicResource Text.Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.OnAccent}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="New connection" FontSize="17" FontWeight="SemiBold" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ActionCard}" Command="{Binding OpenSqliteFileCommand}" AutomationProperties.Name="Open SQLite file">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}">
                                    <TextBlock Text="&#xE0D7;" Style="{DynamicResource Text.Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Open SQLite file" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ActionCard}" IsEnabled="False" ToolTip="Coming soon"
                                AutomationProperties.Name="Import connections">
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}">
                                    <TextBlock Text="&#xE0B2;" Style="{DynamicResource Text.Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Import connections" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </Grid>

                    <Grid Margin="0,30,0,0" Height="72">
                        <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="1" StrokeDashArray="4 3"
                                   Stroke="{DynamicResource Brush.Border.Default}" />
                        <DockPanel Margin="22,0" VerticalAlignment="Center">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <controls:EngineBadge Kind="PostgreSql" Width="32" Height="32" Margin="6,0,0,0" />
                                <controls:EngineBadge Kind="MySql" Width="32" Height="32" Margin="6,0,0,0" />
                                <controls:EngineBadge Kind="Sqlite" Width="32" Height="32" Margin="6,0,0,0" />
                                <controls:EngineBadge Kind="SqlServer" Width="32" Height="32" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="&#xE318;" Style="{DynamicResource Text.Icon}" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="Drop a SQLite file here" Margin="16,0,0,0" FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" Background="{DynamicResource Brush.Bg.Rail}">
                <DockPanel Margin="24,13">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource LinkButton}" Content="Keyboard shortcuts" Command="{Binding ShowShortcutsCommand}" />
                        <Button Style="{StaticResource LinkButton}" Content="Settings" Command="{Binding ShowSettingsCommand}" ToolTip="Ctrl+," />
                    </StackPanel>
                    <TextBlock Text="{x:Static vm:MainViewModel.Version}" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid themes:Fade.OnShow="True">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Connections.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EditorPage, Converter={x:Static app:Converters.NullToBool}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Brush.Bg.Sidebar}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Border.Subtle}">
                <DockPanel Margin="14,20,14,12">
                    <Button DockPanel.Dock="Top" Style="{DynamicResource Button.Primary}" Height="42" Padding="16,0" HorizontalContentAlignment="Stretch"
                            Command="{Binding NewCommand}" ToolTip="Ctrl+N" AutomationProperties.Name="New connection">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Keycap}" Padding="6,1,6,2" Background="{DynamicResource Brush.Accent.Pressed}">
                                <TextBlock Text="Ctrl N" FontSize="11.5" Foreground="{DynamicResource Brush.Text.OnAccent}" />
                            </Border>
                            <TextBlock Text="&#xE13D;" Style="{DynamicResource Text.Icon}" FontSize="12" Margin="0,1,12,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.OnAccent}" />
                            <TextBlock Text="New connection" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <Button DockPanel.Dock="Top" Margin="0,18,0,2" Style="{StaticResource SidebarItem}" Command="{Binding OpenSqliteFileCommand}"
                            ToolTip="Ctrl+O" AutomationProperties.Name="Open SQLite file">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl O" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            <TextBlock Text="&#xE0D7;" Style="{DynamicResource Text.Icon}" FontSize="14" Margin="0,1,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Open SQLite file" FontSize="14" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <Button DockPanel.Dock="Top" Style="{StaticResource SidebarItem}" IsEnabled="False" ToolTip="Coming soon"
                            AutomationProperties.Name="Import connections">
                        <DockPanel>
                            <TextBlock Text="&#xE0B2;" Style="{DynamicResource Text.Icon}" FontSize="14" Margin="0,1,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="Import connections" FontSize="14" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <DockPanel DockPanel.Dock="Bottom">
                        <TextBlock DockPanel.Dock="Right" Text="{x:Static vm:MainViewModel.Version}" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <Button Style="{DynamicResource Button.Ghost}" HorizontalAlignment="Left" Padding="10,6" Command="{Binding ShowSettingsCommand}"
                                ToolTip="Ctrl+," AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE154;" Style="{DynamicResource Text.Icon}" FontSize="14" Margin="0,1,10,0" />
                                <TextBlock Text="Settings" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TAGS" Style="{StaticResource SectionLabel}" Margin="14,28,0,10" />
                    <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" ItemContainerStyle="{StaticResource GroupRow}"
                             Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Tags" />
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="OnBackgroundMouseDown">
            <Grid Margin="32,26,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel>
                    <Grid DockPanel.Dock="Right" Width="380">
                        <TextBox x:Name="ListSearch" Style="{StaticResource SearchBox}" Padding="40,9,64,9" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 themes:Hint.Text="Search name, host or user…" PreviewKeyDown="OnSearchKeyDown" AutomationProperties.Name="Search connections" />
                        <TextBlock Text="&#xE151;" Style="{DynamicResource Text.Icon}" FontSize="14" Margin="15,0,0,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <Border Style="{StaticResource Keycap}" Padding="6,1,6,2" Margin="0,0,10,0" HorizontalAlignment="Right" IsHitTestVisible="False">
                            <TextBlock Text="Ctrl K" FontSize="11.5" />
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Connections" FontSize="26" FontWeight="SemiBold" FontFamily="{DynamicResource Font.Display}" />
                        <Border Margin="12,4,0,0" Padding="9,1,9,2" CornerRadius="11" VerticalAlignment="Center" Background="{DynamicResource Brush.Bg.Hover}">
                            <TextBlock Text="{Binding Connections.Count}" FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="0,30,0,0" Visibility="{Binding ShowRecent, Converter={x:Static app:Converters.BoolToVisibility}}"
                            themes:Fade.OnShow="True">
                    <TextBlock Text="RECENT" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                    <ListBox ItemsSource="{Binding Recent}" SelectedItem="{Binding SelectedConnection}" ItemContainerStyle="{StaticResource RecentCard}"
                             Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,-14,0" ContextMenu="{DynamicResource ConnectionMenu}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Recent connections" KeyDown="OnListKeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ConnectCommand}" />
                            <KeyBinding Key="F2" Command="{Binding EditCommand}" />
                        </ListBox.InputBindings>
                    </ListBox>
                </StackPanel>

                <DockPanel Grid.Row="2" Margin="0,30,0,12">
                    <Button DockPanel.Dock="Right" Padding="12,5" Command="{Binding ToggleSortCommand}" AutomationProperties.Name="Sort">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE37D;" Style="{DynamicResource Text.Icon}" FontSize="12" Margin="0,1,9,0" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Last used" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SortByName}" Value="True">
                                                <Setter Property="Text" Value="Name" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="ALL CONNECTIONS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                </DockPanel>

                <Border Grid.Row="3" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        Background="{DynamicResource Brush.Bg.Card}" VerticalAlignment="Top" ClipToBounds="True">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Height="46" TextElement.FontSize="13.5" TextElement.Foreground="{DynamicResource Brush.Text.Secondary}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="2.6*" />
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Margin="20,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Address" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Tag" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Last used" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <ListBox x:Name="HomeList" ItemsSource="{Binding Lists.FilteredConnections, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedConnection}"
                                     ItemContainerStyle="{StaticResource HomeRow}" ContextMenu="{DynamicResource ConnectionMenu}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     AutomationProperties.Name="Connections" KeyDown="OnListKeyDown">
                                <ListBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ConnectCommand}" />
                                    <KeyBinding Key="F2" Command="{Binding EditCommand}" />
                                    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
                                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                                </ListBox.InputBindings>
                            </ListBox>
                            <TextBlock Text="No matches" themes:Fade.OnShow="True" Margin="0,24" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Visibility="{Binding HasNoMatches, Converter={x:Static app:Converters.BoolToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            </Grid>

            <Border x:Name="DetailPanel" Grid.Column="2" Width="328" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Bg.Sidebar}" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}">
                <DockPanel x:Name="DetailContent" DataContext="{x:Null}">
                    <DockPanel.RenderTransform>
                        <TranslateTransform />
                    </DockPanel.RenderTransform>
                    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" Padding="22,12">
                        <Button Style="{DynamicResource Button.Link}" HorizontalAlignment="Left" Content="Delete connection…" FontSize="14"
                                Foreground="{DynamicResource Brush.Danger}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <StackPanel Margin="22,24,22,22">
                                <DockPanel>
                                    <controls:EngineBadge Kind="{Binding Kind}" Width="52" Height="52" />
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Kind, Converter={x:Static app:Converters.KindName}}" Margin="0,2,0,0" FontSize="14"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,20,0,0">
                                    <Button DockPanel.Dock="Right" Width="42" Height="42" Padding="0" Margin="8,0,0,0" ToolTip="Duplicate (Ctrl+D)"
                                            AutomationProperties.Name="Duplicate"
                                            Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE09E;" Style="{DynamicResource Text.Icon}" FontSize="14" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Width="42" Height="42" Padding="0" Margin="8,0,0,0" ToolTip="Edit (F2)"
                                            AutomationProperties.Name="Edit"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE1F9;" Style="{DynamicResource Text.Icon}" FontSize="14" />
                                    </Button>
                                    <Button Style="{DynamicResource Button.Primary}" Height="42" HorizontalContentAlignment="Center"
                                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Connect" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Keycap}" Margin="10,0,0,0" Padding="6,1,6,2" Background="{DynamicResource Brush.Accent.Pressed}">
                                                <TextBlock Text="Enter" FontSize="11.5" Foreground="{DynamicResource Brush.Text.OnAccent}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                                <Button Margin="0,10,0,0" Height="40" HorizontalContentAlignment="Center"
                                        Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE1B4;" Style="{DynamicResource Text.Icon}" FontSize="13" Margin="0,1,10,0" />
                                        <TextBlock Text="Test connection" FontSize="14" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" Padding="22,20,22,22">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Converter={x:Static app:Converters.ProfileDetails}}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,13">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" Style="{StaticResource DetailLabel}" />
                                                    <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Value}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Key}" Value="Host">
                                                        <Setter TargetName="Value" Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Key}" Value="Port">
                                                        <Setter TargetName="Value" Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Key}" Value="User">
                                                        <Setter TargetName="Value" Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Key}" Value="Database">
                                                        <Setter TargetName="Value" Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Key}" Value="File">
                                                        <Setter TargetName="Value" Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Margin="0,8,0,0" Padding="16,14,8,8" CornerRadius="12" BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}" Background="{DynamicResource Brush.Bg.App}">
                                        <StackPanel>
                                            <TextBlock Text="Tag" FontSize="14" Margin="0,0,0,10" />
                                            <ItemsControl ItemsSource="{x:Static vm:ConnectionTags.Choices}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button x:Name="Chip" Padding="11,4" Margin="0,0,8,8" Background="Transparent"
                                                                AutomationProperties.Name="{Binding Name}"
                                                                Command="{Binding DataContext.SetTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Color}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center"
                                                                         Fill="{Binding Color, Converter={x:Static app:Converters.HexToBrush}}" />
                                                                <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                                            </StackPanel>
                                                        </Button>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{x:Static app:Converters.AreEqual}">
                                                                        <Binding Path="Color" />
                                                                        <Binding Path="DataContext.SelectedConnection.Color" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{Binding Color, Converter={x:Static app:Converters.HexToBrush}}" />
                                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    Background="{DynamicResource Brush.Bg.Rail}">
                <DockPanel Margin="18,9">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource CheckBox.Switch}" Content="Reopen last session on startup" IsEnabled="False"
                              ToolTipService.ShowOnDisabled="True" ToolTip="Coming soon" />
                    <TextBlock Text="&#xE10B;" Style="{DynamicResource Text.Icon}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="Passwords are encrypted with Windows DPAPI" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid themes:Fade.OnShow="True" Visibility="{Binding EditorPage, Converter={x:Static app:Converters.NullToCollapsed}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Brush.Bg.Sidebar}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Border.Subtle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,20,16,14">
                        <TextBlock Text="Connections" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Display}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="34" Height="34" Padding="0" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Import · coming soon" AutomationProperties.Name="Import">
                                <TextBlock Text="&#xE0B2;" Style="{DynamicResource Text.Icon}" FontSize="13" />
                            </Button>
                            <Button Margin="8,0,0,0" Height="34" Padding="14,0" Style="{DynamicResource Button.Primary}"
                                    Command="{Binding SwitchEditorCommand}" ToolTip="New connection" AutomationProperties.Name="New connection">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE13D;" Style="{DynamicResource Text.Icon}" FontSize="11" Margin="0,1,8,0"
                                               Foreground="{DynamicResource Brush.Text.OnAccent}" />
                                    <TextBlock Text="New" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="16,0,16,10">
                        <TextBox Style="{StaticResource SearchBox}" Padding="36,7,10,7" FontSize="13" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 themes:Hint.Text="Search connections…" AutomationProperties.Name="Search connections" />
                        <TextBlock Text="&#xE151;" Style="{DynamicResource Text.Icon}" FontSize="12" Margin="13,0,0,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Lists.GroupedConnections, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedConnection}" ItemContainerStyle="{StaticResource EditorRow}"
                             Background="Transparent" BorderThickness="0" Padding="12,0,12,12" PreviewKeyDown="OnEditorListKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Connections">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="6,12,0,6">
                                            <Grid Width="8" Height="8" Margin="0,1,9,0">
                                                <Ellipse Fill="{DynamicResource Brush.Text.Tertiary}" />
                                                <Ellipse Fill="{Binding Items[0].Color, Converter={x:Static app:Converters.HexToBrush}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name, Converter={x:Static app:Converters.Upper}}" Style="{StaticResource SectionLabel}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding EditorPage}" Focusable="False" />
        </Grid>
    </Grid>
</UserControl>
