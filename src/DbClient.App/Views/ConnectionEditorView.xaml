<UserControl x:Class="DbClient.App.Views.ConnectionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:DbClient.App"
             xmlns:controls="clr-namespace:DbClient.App.Controls"
             xmlns:themes="clr-namespace:DbClient.App.Themes"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:DbClient.ViewModels;assembly=DbClient.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ConnectionEditorViewModel}"
             DataContextChanged="OnDataContextChanged">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,7" />
        </Style>

        <Style x:Key="EngineTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border CornerRadius="10" BorderThickness="1" Background="{DynamicResource Brush.Bg.Input}" BorderBrush="{DynamicResource Brush.Border.Default}" />
                            <Border CornerRadius="10" Background="{DynamicResource Brush.Bg.Hover}" Opacity="0" themes:Fade.Visible="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border CornerRadius="10" BorderThickness="2" Background="{DynamicResource Brush.Accent.Subtle}" BorderBrush="{DynamicResource Brush.Accent}"
                                    Opacity="0" themes:Fade.Visible="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
                            <StackPanel HorizontalAlignment="Center" Margin="9,15,9,13">
                                <controls:EngineBadge Kind="{Binding Kind}" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}" Margin="0,9,0,0" FontSize="13" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Primary}" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="32" Height="32" Background="Transparent">
                            <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="{DynamicResource Brush.Text.Primary}" Visibility="Hidden" />
                            <Ellipse x:Name="Dot" Width="22" Height="22" Fill="{Binding Hex, Converter={x:Static app:Converters.HexToBrush}}"
                                     Stroke="#40000000" StrokeThickness="1" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Grid Width="22" Height="22" Visibility="{Binding Hex, Converter={x:Static app:Converters.NotNullToCollapsed}}">
                                <Ellipse Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1" />
                                <Line X1="5" Y1="17" X2="17" Y2="5" Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Border.Focus}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnderlineTab" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,26,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <TextBlock Text="{Binding}" FontSize="14" Margin="0,0,0,11" />
                            <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" CornerRadius="1" Background="{DynamicResource Brush.Accent}" Opacity="0"
                                    themes:Fade.Visible="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="40,30,40,24" MaxWidth="1060">
                <Grid Margin="0,0,0,26">
                    <StackPanel Margin="0,0,140,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Text="{Binding Heading}" Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource Font.Display}" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,3,12,4" CornerRadius="13" BorderThickness="1"
                            BorderBrush="{Binding SelectedColor.Hex, Converter={x:Static app:Converters.HexToBrush}}"
                            Visibility="{Binding SelectedColor.Hex, Converter={x:Static app:Converters.NullToCollapsed}}">
                        <TextBlock Text="{Binding SelectedColor.Hex, Converter={x:Static app:Converters.TagName}}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding SelectedColor.Hex, Converter={x:Static app:Converters.HexToBrush}}" />
                    </Border>
                </Grid>

                <TextBlock Text="Database engine" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" />
                <ListBox Style="{StaticResource PickerList}" Margin="0,0,-10,0"
                         ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}"
                         ItemContainerStyle="{StaticResource EngineTile}" AutomationProperties.Name="Engine">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Grid Margin="0,28,0,24">
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Border.Subtle}" />
                    <ListBox x:Name="SectionTabs" Style="{StaticResource PickerList}" SelectedIndex="0"
                             ItemContainerStyle="{StaticResource UnderlineTab}" AutomationProperties.Name="Sections">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <sys:String>General</sys:String>
                        <sys:String>SSL</sys:String>
                        <sys:String>Advanced</sys:String>
                    </ListBox>
                </Grid>

                <StackPanel themes:Fade.OnShow="True">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource TabPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SectionTabs}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="12,7" FontSize="13.5"
                                     themes:Hint.Text="Defaults to the host or file name" AutomationProperties.Name="Name" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                            <TextBlock Text="Color tag" Style="{StaticResource FieldLabel}" />
                            <ListBox Style="{StaticResource PickerList}" Margin="-3,0,0,0"
                                     ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}"
                                     ItemContainerStyle="{StaticResource SwatchItem}" AutomationProperties.Name="Color tag">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding IsNetwork, Converter={x:Static app:Converters.BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="Host" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource Mono}" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                         themes:Hint.Text="Host name or IP" themes:Hint.Error="{Binding HostError}" AutomationProperties.Name="Host" />
                                <TextBlock Text="{Binding HostError}" Style="{StaticResource FieldError}"
                                           Visibility="{Binding HostError, Converter={x:Static app:Converters.NullToCollapsed}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                                <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource Mono}" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                         themes:Hint.Error="{Binding PortError}" AutomationProperties.Name="Port" />
                                <TextBlock Text="{Binding PortError}" Style="{StaticResource FieldError}"
                                           Visibility="{Binding PortError, Converter={x:Static app:Converters.NullToCollapsed}}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="User" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource Mono}" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="User"
                                         themes:Hint.Text="{Binding UserHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                <Grid IsEnabled="{Binding IsPasswordEnabled}">
                                    <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" Padding="12,7,40,7"
                                                 AutomationProperties.Name="Password" />
                                    <TextBox x:Name="PasswordReveal" Visibility="Collapsed" TextChanged="OnRevealTextChanged" Padding="12,7,40,7"
                                             FontFamily="{DynamicResource Font.Mono}" AutomationProperties.Name="Password (visible)" />
                                    <Button x:Name="RevealButton" Style="{DynamicResource Button.Icon}" Width="30" Height="30"
                                            HorizontalAlignment="Right" Margin="0,0,4,0" IsTabStop="False"
                                            Click="OnToggleReveal" ToolTip="Show password" AutomationProperties.Name="Show password">
                                        <TextBlock x:Name="RevealGlyph" Text="&#xE0BA;" Style="{DynamicResource Text.Icon}" FontSize="13" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="Database" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource Mono}" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                         themes:Hint.Text="Optional" AutomationProperties.Name="Database" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                                <TextBlock Text="SSL mode" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static vm:ConnectionEditorViewModel.SslOptions}" Height="36"
                                          SelectedValuePath="Mode" SelectedValue="{Binding SslMode}" AutomationProperties.Name="SSL mode">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SslOption}">
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldHint}" Visibility="{Binding ShowTunnelHostCheckHint, Converter={x:Static app:Converters.BoolToVisibility}}"
                                           Text="Verify full fails through SSH (host is 127.0.0.1). Use Verify CA." />
                                <TextBlock Style="{StaticResource FieldHint}" Foreground="{DynamicResource Brush.Warning}" Text="{Binding SslWarning}"
                                           Visibility="{Binding SslWarning, Converter={x:Static app:Converters.NullToCollapsed}}" />
                                <TextBlock Text="{Binding SslFileError}" Style="{StaticResource FieldError}"
                                           Visibility="{Binding SslFileError, Converter={x:Static app:Converters.NullToCollapsed}}" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,4,0,0" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                Background="{DynamicResource Brush.Bg.Card}" Padding="20,16">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{DynamicResource CheckBox.Switch}" VerticalAlignment="Center"
                                              IsChecked="{Binding SshEnabled}" AutomationProperties.Name="Connect via SSH tunnel" />
                                    <TextBlock Text="SSH tunnel" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>

                                <StackPanel Margin="0,18,0,0" Visibility="{Binding SshEnabled, Converter={x:Static app:Converters.BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Style="{StaticResource Field}">
                                            <TextBlock Text="SSH host" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource Mono}" Text="{Binding SshHost, UpdateSourceTrigger=PropertyChanged}"
                                                     themes:Hint.Text="bastion.example.com" themes:Hint.Error="{Binding SshHostError}" AutomationProperties.Name="SSH host" />
                                            <TextBlock Text="{Binding SshHostError}" Style="{StaticResource FieldError}"
                                                       Visibility="{Binding SshHostError, Converter={x:Static app:Converters.NullToCollapsed}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource Mono}" Text="{Binding SshPortText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                                     themes:Hint.Error="{Binding SshPortError}" AutomationProperties.Name="SSH port" />
                                            <TextBlock Text="{Binding SshPortError}" Style="{StaticResource FieldError}"
                                                       Visibility="{Binding SshPortError, Converter={x:Static app:Converters.NullToCollapsed}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Style="{StaticResource Field}">
                                            <TextBlock Text="SSH user" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource Mono}" Text="{Binding SshUser, UpdateSourceTrigger=PropertyChanged}"
                                                     themes:Hint.Error="{Binding SshUserError}" AutomationProperties.Name="SSH user" />
                                            <TextBlock Text="{Binding SshUserError}" Style="{StaticResource FieldError}"
                                                       Visibility="{Binding SshUserError, Converter={x:Static app:Converters.NullToCollapsed}}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Style="{StaticResource Field}">
                                            <TextBlock Text="Private key" Style="{StaticResource FieldLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource Mono}" Text="{Binding SshKeyFile, UpdateSourceTrigger=PropertyChanged}"
                                                         themes:Hint.Text="Empty = sign in with a password" themes:Hint.Error="{Binding SshKeyError}"
                                                         AutomationProperties.Name="Private key file" />
                                                <Button Grid.Column="1" Margin="10,0,0,0" Padding="16,7" Click="OnBrowseFile" Tag="ssh-key" Content="Browse…"
                                                        AutomationProperties.Name="Browse for private key" />
                                            </Grid>
                                            <TextBlock Text="{Binding SshKeyError}" Style="{StaticResource FieldError}"
                                                       Visibility="{Binding SshKeyError, Converter={x:Static app:Converters.NullToCollapsed}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                                            <TextBlock Text="{Binding SshSecretLabel}" Style="{StaticResource FieldLabel}" />
                                            <PasswordBox x:Name="SshSecretInput" PasswordChanged="OnSshSecretChanged" Padding="12,7"
                                                         AutomationProperties.Name="SSH password or key passphrase" />
                                        </StackPanel>
                                    </Grid>

                                    <DockPanel Visibility="{Binding HasSshHostKey, Converter={x:Static app:Converters.BoolToVisibility}}">
                                        <Button DockPanel.Dock="Right" Padding="12,5" Content="Forget" Command="{Binding ForgetSshHostKeyCommand}"
                                                AutomationProperties.Name="Forget SSH host key" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Trusted host key" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            <TextBlock Text="{Binding SshHostKey}" Margin="0,2,12,0" FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SshHostKey}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsFile, Converter={x:Static app:Converters.BoolToVisibility}}">
                        <TextBlock Text="Database file" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Mono}" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                     themes:Hint.Text="C:\path\to\database.db" themes:Hint.Error="{Binding FileError}" AutomationProperties.Name="Database file" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Padding="16,7" Click="OnBrowse" Content="Browse…" AutomationProperties.Name="Browse" />
                        </Grid>
                        <TextBlock Text="{Binding FileError}" Style="{StaticResource FieldError}"
                                   Visibility="{Binding FileError, Converter={x:Static app:Converters.NullToCollapsed}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel themes:Fade.OnShow="True" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource TabPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SectionTabs}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Certificates" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"
                               Visibility="{Binding HasSslFiles, Converter={x:Static app:Converters.TrueToCollapsed}}"
                               Text="SQL Server uses the Windows certificate store." />
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasSslFiles, Converter={x:Static app:Converters.BoolToVisibility}}">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="CA certificate" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Mono}" Text="{Binding SslCaFile, UpdateSourceTrigger=PropertyChanged}"
                                         themes:Hint.Text="Optional" AutomationProperties.Name="CA certificate file" />
                                <Button Grid.Column="1" Margin="10,0,0,0" Padding="16,7" Click="OnBrowseFile" Tag="ssl-ca" Content="Browse…"
                                        AutomationProperties.Name="Browse for CA certificate" />
                            </Grid>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="Client certificate" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource Mono}" Text="{Binding SslCertFile, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Client certificate file" />
                                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="16,7" Click="OnBrowseFile" Tag="ssl-cert" Content="Browse…"
                                            AutomationProperties.Name="Browse for client certificate" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                                <TextBlock Text="Client key" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource Mono}" Text="{Binding SslKeyFile, UpdateSourceTrigger=PropertyChanged}"
                                             themes:Hint.Text="Unencrypted key" AutomationProperties.Name="Client key file" />
                                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="16,7" Click="OnBrowseFile" Tag="ssl-key" Content="Browse…"
                                            AutomationProperties.Name="Browse for client key" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SslFileError}" Style="{StaticResource FieldError}"
                                   Visibility="{Binding SslFileError, Converter={x:Static app:Converters.NullToCollapsed}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel themes:Fade.OnShow="True" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource TabPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SectionTabs}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Advanced" FontSize="14" FontWeight="SemiBold" />
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox DockPanel.Dock="Right" Style="{DynamicResource CheckBox.Switch}" VerticalAlignment="Center"
                                  IsChecked="{Binding ReadOnly}" AutomationProperties.Name="Read-only" />
                        <TextBlock Text="Read-only" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}">
            <Grid Margin="40,14" MaxWidth="1060">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Button Padding="14,7" Command="{Binding TestCommand}" ToolTip="Test connection"
                            AutomationProperties.Name="Test connection"
                            Visibility="{Binding TestCommand.IsRunning, Converter={x:Static app:Converters.TrueToCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE1B4;" Style="{DynamicResource Text.Icon}" FontSize="13" Margin="0,0,9,0" />
                            <TextBlock Text="Test connection" />
                        </StackPanel>
                    </Button>
                    <Button Padding="14,7" Command="{Binding TestCancelCommand}" ToolTip="Stop the test" AutomationProperties.Name="Stop test"
                            Visibility="{Binding TestCommand.IsRunning, Converter={x:Static app:Converters.BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Spinner Width="13" Height="13" Margin="0,0,9,0" />
                            <TextBlock Text="Testing… Stop" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel themes:Fade.OnShow="True" Grid.Column="1" Orientation="Horizontal" Margin="16,0,16,0" VerticalAlignment="Center" ToolTip="{Binding TestMessage}">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestState}" Value="{x:Static vm:TestState.Succeeded}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestState}" Value="{x:Static vm:TestState.Failed}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,1,8,0" FontFamily="{DynamicResource Font.Icons}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE06C;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestState}" Value="{x:Static vm:TestState.Failed}">
                                        <Setter Property="Text" Value="&#xE077;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding TestMessage}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{DynamicResource Button.Ghost}" Content="Cancel" Padding="16,7" Command="{Binding CancelCommand}" ToolTip="Esc" />
                    <Button Content="Save" Padding="18,7" Margin="8,0,0,0" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+Enter)" />
                    <Button Content="Connect" Padding="20,7" Margin="8,0,0,0" IsDefault="True" Style="{DynamicResource Button.Primary}"
                            Command="{Binding SaveAndConnectCommand}" ToolTip="Save and connect (Enter)" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
