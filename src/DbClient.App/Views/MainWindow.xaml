<Window x:Class="DbClient.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:DbClient.App"
        xmlns:controls="clr-namespace:DbClient.App.Controls"
        xmlns:themes="clr-namespace:DbClient.App.Themes"
        xmlns:views="clr-namespace:DbClient.App.Views"
        xmlns:vm="clr-namespace:DbClient.ViewModels;assembly=DbClient.ViewModels"
        xmlns:core="clr-namespace:DbClient.Core.Services;assembly=DbClient.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding ActiveConnection.Name, StringFormat={}{0} - Qorra, FallbackValue=Qorra, TargetNullValue=Qorra}" Icon="/Assets/app.ico"
        Width="1280" Height="780" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Style="{DynamicResource Window.Base}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Geometry x:Key="Ico.Database">M2.5,3.5 C2.5,1.5 11.5,1.5 11.5,3.5 L11.5,10.5 C11.5,12.5 2.5,12.5 2.5,10.5 Z M2.5,3.5 C2.5,5.5 11.5,5.5 11.5,3.5 M2.5,7 C2.5,9 11.5,9 11.5,7</Geometry>
        <Geometry x:Key="Ico.Table">M1.5,2.5 L12.5,2.5 L12.5,11.5 L1.5,11.5 Z M1.5,5.5 L12.5,5.5 M1.5,8.5 L12.5,8.5 M5.5,5.5 L5.5,11.5</Geometry>
        <Geometry x:Key="Ico.View">M1.5,2.5 L12.5,2.5 L12.5,11.5 L1.5,11.5 Z M1.5,5.5 L12.5,5.5 M4,8.5 C5.5,6.75 8.5,6.75 10,8.5 C8.5,10.25 5.5,10.25 4,8.5 Z</Geometry>
        <Geometry x:Key="Ico.Plug">M5,1.5 L5,4.5 M9,1.5 L9,4.5 M3.5,4.5 L10.5,4.5 L10.5,7 C10.5,9 9,10.5 7,10.5 C5,10.5 3.5,9 3.5,7 Z M7,10.5 L7,12.5</Geometry>
        <Geometry x:Key="Ico.Schema">M7,1.5 L12.5,4.25 L7,7 L1.5,4.25 Z M1.5,7 L7,9.75 L12.5,7 M1.5,9.75 L7,12.5 L12.5,9.75</Geometry>

        <Style x:Key="Ico" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Border Background="{DynamicResource Brush.Bg.Hover}" Opacity="0">
                                <themes:Fade.Visible>
                                    <MultiBinding Converter="{x:Static themes:Fade.AnyTrue}" ConverterParameter="Hot">
                                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </themes:Fade.Visible>
                            </Border>
                            <Border Background="{DynamicResource Brush.Bg.Pressed}" Opacity="0">
                                <themes:Fade.Visible>
                                    <MultiBinding Converter="{x:Static themes:Fade.AnyTrue}" ConverterParameter="Pressed">
                                        <Binding Path="IsPressed" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </themes:Fade.Visible>
                            </Border>
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{DynamicResource Font.Caption}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Border x:Name="Red" Background="#C42B1C" Opacity="0">
                                <themes:Fade.Visible>
                                    <MultiBinding Converter="{x:Static themes:Fade.AnyTrue}" ConverterParameter="Hot">
                                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </themes:Fade.Visible>
                            </Border>
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{DynamicResource Font.Caption}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Red" Property="Background" Value="#C83C30" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="9" Background="{DynamicResource Brush.Bg.Hover}" Opacity="0"
                                    themes:Fade.Visible="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border CornerRadius="9" Background="{DynamicResource Brush.Accent.Subtle}" Opacity="0"
                                    themes:Fade.Visible="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabStripItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
            <EventSetter Event="PreviewMouseDown" Handler="OnTabMouseDown" />
            <EventSetter Event="PreviewMouseMove" Handler="OnTabMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnTabMouseUp" />
            <EventSetter Event="LostMouseCapture" Handler="OnTabLostCapture" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="36" Width="200" VerticalAlignment="Bottom" Background="Transparent">
                            <Border x:Name="Sep" Width="1" Height="18" Margin="0,0,0,2" HorizontalAlignment="Right"
                                    Background="{DynamicResource Brush.Border.Default}" />
                            <Border CornerRadius="8" Margin="4,4,4,5" Background="{DynamicResource Brush.Bg.Hover}" Opacity="0"
                                    themes:Fade.Visible="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Grid Margin="-11,0,-11,0" Opacity="0" themes:Fade.Visible="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}">
                                <Path Fill="{DynamicResource Brush.Bg.App}"
                                      Data="M0,36 A10,10 0 0 0 10,26 L10,10 A10,10 0 0 1 20,0 L202,0 A10,10 0 0 1 212,10 L212,26 A10,10 0 0 0 222,36 Z" />
                                <Path Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" Opacity="0.85"
                                      Data="M0,35.5 A9.5,9.5 0 0 0 10.5,26 L10.5,10.5 A10,10 0 0 1 20.5,0.5 L201.5,0.5 A10,10 0 0 1 211.5,10.5 L211.5,26 A9.5,9.5 0 0 0 222,35.5" />
                            </Grid>
                            <Grid Margin="14,0,8,1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Text="{Binding Icon}" Style="{DynamicResource Text.Icon}" FontSize="13" Margin="0,0,10,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Icon.Object}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Column="2" Width="22" Height="22" Margin="6,0,0,0">
                                    <Ellipse x:Name="Dirty" Width="7" Height="7" Fill="{DynamicResource Brush.Text.Secondary}"
                                             Visibility="{Binding HasChanges, Converter={x:Static app:Converters.BoolToVisibility}}" />
                                    <Button x:Name="Close" Style="{StaticResource TabClose}" Width="22" Height="22"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip="Close (Ctrl+W)" />
                                </Grid>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                <Setter TargetName="Sep" Property="Visibility" Value="Hidden" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                <Setter TargetName="Dirty" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="Sep" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Kind}" Value="View">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Icon.View}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Query">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Icon.Query}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasChanges}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Close" Property="Visibility" Value="Hidden" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Geometry x:Key="Ico.Locate">M7,3 A4,4 0 1 1 7,11 A4,4 0 1 1 7,3 Z M7,0.5 L7,3 M7,11 L7,13.5 M0.5,7 L3,7 M11,7 L13.5,7</Geometry>
        <Geometry x:Key="Ico.Folder">M1.5,11.5 L1.5,2.5 L5.5,2.5 L7,4 L12.5,4 L12.5,11.5 Z</Geometry>
        <Geometry x:Key="Ico.Column">M3.5,1.5 L10.5,1.5 L10.5,12.5 L3.5,12.5 Z M3.5,4.5 L10.5,4.5</Geometry>
        <Geometry x:Key="Ico.Key">M1.5,7 A2.5,2.5 0 1 1 6.5,7 A2.5,2.5 0 1 1 1.5,7 Z M6.5,7 L12.5,7 M10.5,7 L10.5,9.5 M12.5,7 L12.5,9</Geometry>
        <Geometry x:Key="Ico.ForeignKey">M1.5,4.5 L5.5,4.5 L5.5,9.5 L1.5,9.5 Z M5.5,7 L12,7 M9.5,4.5 L12,7 L9.5,9.5</Geometry>
        <Geometry x:Key="Ico.Index">M1.5,3.5 L12.5,3.5 M1.5,7 L9.5,7 M1.5,10.5 L6.5,10.5</Geometry>
        <Geometry x:Key="Ico.Check">M2.5,7.5 L5.5,10.5 L11.5,3.5</Geometry>
        <Geometry x:Key="Ico.Function">M10.5,2 C8.5,1.5 7.5,2.5 7,4.5 L5.5,10 C5,12 4,12.5 2.5,12 M4.5,5.5 L10,5.5</Geometry>
        <Geometry x:Key="Ico.Enum">M2,3.5 L3,3.5 M5,3.5 L12.5,3.5 M2,7 L3,7 M5,7 L12.5,7 M2,10.5 L3,10.5 M5,10.5 L12.5,10.5</Geometry>
        <Geometry x:Key="Ico.Sequence">M1.5,12 L4.5,12 L4.5,9 L7.5,9 L7.5,6 L10.5,6 L10.5,3 L12.5,3</Geometry>

        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="900" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Visibility" Value="{Binding IsHidden, Converter={x:Static app:Converters.TrueToCollapsed}}" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:SchemaNode}" ItemsSource="{Binding Children}">
            <Grid x:Name="Row" MinHeight="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path x:Name="Shape" Style="{StaticResource Ico}" Data="{StaticResource Ico.Table}" HorizontalAlignment="Left"
                      TextElement.Foreground="{DynamicResource Brush.Icon.Object}" />
                <TextBlock x:Name="Glyph" Style="{DynamicResource Text.Icon}" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                <controls:Spinner x:Name="Spin" Width="12" Height="12" HorizontalAlignment="Left" Visibility="Collapsed" />
                <TextBlock x:Name="Label" Grid.Column="1" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " FontSize="11" /><Run Text="{Binding Detail, Mode=OneWay}"
                         FontFamily="{DynamicResource Font.Mono}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </TextBlock>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsObject}" Value="True">
                    <Setter TargetName="Row" Property="MinHeight" Value="28" />
                    <Setter TargetName="Label" Property="FontSize" Value="13" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Schema">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.Schema}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                    <Setter TargetName="Row" Property="MinHeight" Value="28" />
                    <Setter TargetName="Label" Property="FontSize" Value="13" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="View">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.View}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Icon.View}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Folder">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.Folder}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Icon.Object}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Column">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.Column}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Icon.Column}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Key">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.Key}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Pending}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="ForeignKey">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.ForeignKey}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Icon.Object}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Index">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.Index}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Icon.Index}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Check">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.Check}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Routine">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.Function}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Icon.Routine}" />
                    <Setter TargetName="Row" Property="MinHeight" Value="28" />
                    <Setter TargetName="Label" Property="FontSize" Value="13" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Enum">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.Enum}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Icon.Type}" />
                    <Setter TargetName="Row" Property="MinHeight" Value="28" />
                    <Setter TargetName="Label" Property="FontSize" Value="13" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Sequence">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.Sequence}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Icon.Type}" />
                    <Setter TargetName="Row" Property="MinHeight" Value="28" />
                    <Setter TargetName="Label" Property="FontSize" Value="13" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="EnumValue">
                    <Setter TargetName="Shape" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Label" Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsForeignKey}" Value="True">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.ForeignKey}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Icon.Object}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPrimaryKey}" Value="True">
                    <Setter TargetName="Shape" Property="Data" Value="{StaticResource Ico.Key}" />
                    <Setter TargetName="Shape" Property="TextElement.Foreground" Value="{DynamicResource Brush.Pending}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Loading">
                    <Setter TargetName="Shape" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Spin" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Message">
                    <Setter TargetName="Shape" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter TargetName="Shape" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE077;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <ContextMenu x:Key="ObjectMenu" x:Shared="False">
            <MenuItem Header="Open" InputGestureText="Enter" Command="{Binding OpenTableCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE426;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Query in new tab" Command="{Binding QueryTableCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE093;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Modify table…" Command="{Binding ModifyTableCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE1F9;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="New table…" Command="{Binding NewTableCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE13D;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Duplicate…" Command="{Binding DuplicateTableCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE3FD;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Show DDL" Command="{Binding ShowDdlCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE093;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy DDL" Command="{Binding CopyDdlCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE09E;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy name" InputGestureText="Ctrl+C" Click="OnCopyObjectName">
                <MenuItem.Icon><TextBlock Text="&#xE09E;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Truncate…" Command="{Binding TruncateTableCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE28F;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Drop…" InputGestureText="Del" Command="{Binding DropTableCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE18E;" Style="{DynamicResource Text.Icon}" Foreground="{DynamicResource Brush.Danger}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Refresh" InputGestureText="F5" Command="{Binding RefreshSchemaCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE145;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="SchemaMenu" x:Shared="False">
            <MenuItem Header="New table…" Command="{Binding NewTableCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE13D;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="New query" InputGestureText="Ctrl+T" Command="{Binding NewQueryCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE093;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="New schema…" Command="{Binding NewSchemaCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE13D;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy name" InputGestureText="Ctrl+C" Click="OnCopyObjectName">
                <MenuItem.Icon><TextBlock Text="&#xE09E;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Drop schema…" InputGestureText="Del" Command="{Binding DropSchemaCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE18E;" Style="{DynamicResource Text.Icon}" Foreground="{DynamicResource Brush.Danger}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Refresh" InputGestureText="F5" Command="{Binding RefreshSchemaCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE145;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="RoutineMenu" x:Shared="False">
            <MenuItem Header="Show definition" InputGestureText="Enter" Command="{Binding ShowDefinitionCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Text="&#xE093;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy name" InputGestureText="Ctrl+C" Click="OnCopyObjectName">
                <MenuItem.Icon><TextBlock Text="&#xE09E;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Refresh" InputGestureText="F5" Command="{Binding RefreshSchemaCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE145;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="CatalogMenu" x:Shared="False">
            <MenuItem Header="Copy name" InputGestureText="Ctrl+C" Click="OnCopyObjectName">
                <MenuItem.Icon><TextBlock Text="&#xE09E;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Refresh" InputGestureText="F5" Command="{Binding RefreshSchemaCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE145;" Style="{DynamicResource Text.Icon}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring.Inset}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border CornerRadius="{DynamicResource Radius.Medium}" Background="{DynamicResource Brush.Bg.Hover}" Opacity="0"
                                    themes:Fade.Visible="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Grid Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Chevron" Text="&#xE06F;" FontFamily="{DynamicResource Font.Icons}" FontSize="9" Width="14"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Tertiary}" RenderTransformOrigin="0.35,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" TextElement.FontSize="13" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding Tag}" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="90" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        </Style>

        <DataTemplate DataType="{x:Type vm:TableTabViewModel}">
            <views:TableTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueryTabViewModel}">
            <views:QueryTabView />
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Height="3" VerticalAlignment="Top" Panel.ZIndex="10" IsHitTestVisible="False"
                Background="{Binding TagTint, Converter={x:Static app:Converters.HexToBrush}}"
                Visibility="{Binding TagTint, Converter={x:Static app:Converters.NullToCollapsed}}" />

        <Border Background="{DynamicResource Brush.Bg.Rail}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border.Subtle}" />
        <Grid>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Margin="340,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Image Source="/Assets/logo.png" Width="18" Height="18" Margin="12,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <Menu x:Name="MenuBar" Background="Transparent" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                      IsEnabled="{Binding ModalSheet, Converter={x:Static app:Converters.IsNull}}"
                      MenuItem.SubmenuOpened="OnMenuOpened" AutomationProperties.Name="Menu">
                    <MenuItem Header="_File" Style="{StaticResource MenuBarItem}">
                        <MenuItem Header="New connection&#x2026;" Command="{Binding NewCommand}" Tag="app.newConnection" Icon="&#xE13D;" />
                        <MenuItem Header="Open SQLite file&#x2026;" Command="{Binding OpenSqliteFileCommand}" Tag="app.openFile" Icon="&#xE0C0;" />
                        <MenuItem Header="New window" Command="{Binding NewWindowCommand}" Tag="app.newWindow" Icon="&#xE426;" />
                        <Separator />
                        <MenuItem Header="New query" Command="{Binding NewQueryCommand}" Tag="tab.newQuery" Icon="&#xE093;"
                                  IsEnabled="{Binding ActiveConnection, Converter={x:Static app:Converters.NullToBool}}" />
                        <MenuItem Header="Close tab" Command="{Binding CloseTabCommand}" Tag="tab.close"
                                  IsEnabled="{Binding SelectedTab, Converter={x:Static app:Converters.NullToBool}}" />
                        <MenuItem Header="Close connection" Command="{Binding DisconnectCommand}" Tag="app.closeConnection" Icon="&#xE140;"
                                  IsEnabled="{Binding ActiveConnection, Converter={x:Static app:Converters.NullToBool}}" />
                        <Separator />
                        <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="OnClose" Icon="&#xE10E;" />
                    </MenuItem>
                    <MenuItem Header="_Edit" Style="{StaticResource MenuBarItem}">
                        <MenuItem Command="Undo" Icon="&#xE2A1;" />
                        <MenuItem Command="Redo" Icon="&#xE2A0;" />
                        <Separator />
                        <MenuItem Command="Cut" Icon="&#xE14E;" />
                        <MenuItem Command="Copy" Icon="&#xE09E;" />
                        <MenuItem Command="Paste" Icon="&#xE3E8;" />
                        <Separator />
                        <MenuItem Command="SelectAll" Header="Select all" />
                    </MenuItem>
                    <MenuItem Header="_View" Style="{StaticResource MenuBarItem}"
                              IsEnabled="{Binding ActiveConnection, Converter={x:Static app:Converters.NullToBool}}">
                        <MenuItem Header="Explorer" Command="{Binding ShowExplorerPanelCommand}" IsChecked="{Binding ShowExplorer, Mode=OneWay}" />
                        <MenuItem Header="SQL editor" Command="{Binding ShowEditorPanelCommand}" IsChecked="{Binding IsEditorPanel, Mode=OneWay}" />
                        <MenuItem Header="Query history" Command="{Binding ShowHistoryPanelCommand}" IsChecked="{Binding IsHistoryPanel, Mode=OneWay}" />
                        <Separator />
                        <MenuItem Header="Toggle sidebar" Command="{Binding ToggleSidebarCommand}" Tag="app.toggleSidebar" Icon="&#xE12A;" />
                        <MenuItem Header="Go to object&#x2026;" Command="{Binding OpenGotoCommand}" Tag="app.goto" Icon="&#xE151;" />
                        <Separator />
                        <MenuItem Header="Refresh" Command="{Binding RefreshSchemaCommand}" InputGestureText="F5" Icon="&#xE145;" />
                    </MenuItem>
                    <MenuItem Header="_Tools" Style="{StaticResource MenuBarItem}">
                        <MenuItem Header="Databases&#x2026;" Command="{Binding PickDatabaseCommand}" Icon="&#xE0AD;"
                                  IsEnabled="{Binding ActiveConnection, Converter={x:Static app:Converters.NullToBool}}" />
                        <Separator />
                        <MenuItem Header="Settings&#x2026;" Command="{Binding ShowSettingsCommand}" Tag="app.settings" Icon="&#xE154;" />
                    </MenuItem>
                    <MenuItem Header="_Help" Style="{StaticResource MenuBarItem}">
                        <MenuItem Header="Keyboard shortcuts" Command="{Binding ShowShortcutsCommand}" Icon="&#xE284;" />
                        <MenuItem Header="Open log folder" Click="OnOpenLogFolder" Icon="&#xE247;" />
                        <Separator />
                        <MenuItem Header="About Qorra" Click="OnAbout" Icon="&#xE0F9;" />
                    </MenuItem>
                </Menu>
            </StackPanel>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid x:Name="Workspace" Grid.RowSpan="2" Background="{DynamicResource Brush.Bg.Sidebar}" Visibility="{Binding ActiveConnection, Converter={x:Static app:Converters.NullToCollapsed}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition x:Name="SidebarColumn" Width="264" MinWidth="200" MaxWidth="480" />
            <ColumnDefinition MinWidth="400" />
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" Background="{DynamicResource Brush.Bg.Rail}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Border.Subtle}">
            <DockPanel Margin="0,8,0,10">
                <Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Margin="0" Command="{Binding ShowSettingsCommand}"
                        ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
                    <TextBlock Text="&#xE154;" Style="{DynamicResource Text.Icon}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Margin="0,0,0,4" Command="{Binding NewWindowCommand}"
                        ToolTip="New window (Ctrl+Shift+N)" AutomationProperties.Name="New window">
                    <TextBlock Text="&#xE426;" Style="{DynamicResource Text.Icon}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Margin="0,0,0,4" Command="{Binding DisconnectCommand}"
                        ToolTip="Close connection (Ctrl+Shift+W)" AutomationProperties.Name="Close connection">
                    <TextBlock Text="&#xE140;" Style="{DynamicResource Text.Icon}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <StackPanel HorizontalAlignment="Center">
                    <Button Style="{StaticResource RailButton}" Tag="{Binding ShowExplorer}" Command="{Binding ShowExplorerPanelCommand}"
                            ToolTip="Explorer" AutomationProperties.Name="Explorer">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource Ico.Database}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.4"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource RailButton}" Tag="{Binding IsEditorPanel}" Command="{Binding ShowEditorPanelCommand}"
                            ToolTip="SQL editor" AutomationProperties.Name="SQL editor">
                        <TextBlock Text="&#xE093;" Style="{DynamicResource Text.Icon}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource RailButton}" Tag="{Binding IsHistoryPanel}" Command="{Binding ShowHistoryPanelCommand}"
                            ToolTip="Query history" AutomationProperties.Name="History">
                        <TextBlock Text="&#xE1F5;" Style="{DynamicResource Text.Icon}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="Sidebar" Grid.Column="1" Grid.RowSpan="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="{DynamicResource Brush.Bg.Sidebar}"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" />

        <Grid Margin="10,6,10,0" Visibility="{Binding ShowExplorer, Converter={x:Static app:Converters.BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{DynamicResource Button.Ghost}" Height="32" Padding="8,0" MaxWidth="170"
                    HorizontalContentAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding PickDatabaseCommand}" AutomationProperties.Name="Databases">
                <Button.ToolTip>
                    <TextBlock>
                        <Run Text="{Binding CurrentDatabase, Mode=OneWay}" /><LineBreak /><Run Text="{Binding ServerVersion, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </TextBlock>
                </Button.ToolTip>
                <DockPanel>
                    <Path DockPanel.Dock="Left" Style="{StaticResource Ico}" Data="{StaticResource Ico.Database}" Margin="0,0,8,0"
                          TextElement.Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding CurrentDatabase}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Visibility="{Binding HasDatabasePicker, Converter={x:Static app:Converters.BoolToVisibility}}" />
                    <TextBlock Text="{Binding CurrentSchema}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Visibility="{Binding HasDatabasePicker, Converter={x:Static app:Converters.TrueToCollapsed}}" />
                </DockPanel>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                <controls:Spinner Width="11" Height="11" Margin="0,0,8,0" VerticalAlignment="Center"
                                  Visibility="{Binding IsExplorerLoading, Converter={x:Static app:Converters.BoolToVisibility}}" />
                <Button Style="{DynamicResource Button.Icon}" Width="32" Height="32" WindowChrome.IsHitTestVisibleInChrome="True"
                        Visibility="{Binding HasDatabasePicker, Converter={x:Static app:Converters.TrueToCollapsed}}"
                        Command="{Binding NewTableCommand}" ToolTip="New table" AutomationProperties.Name="New table">
                    <TextBlock Text="&#xE13D;" Style="{DynamicResource Text.Icon}" FontSize="12" />
                </Button>
                <Button Style="{DynamicResource Button.Icon}" Width="32" Height="32" WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding RevealTabCommand}" ToolTip="Reveal open table" AutomationProperties.Name="Reveal open table">
                    <Path Style="{StaticResource Ico}" Data="{StaticResource Ico.Locate}"
                          TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{DynamicResource Button.Icon}" Width="32" Height="32" WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding RefreshSchemaCommand}" ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh explorer">
                    <TextBlock Text="&#xE145;" Style="{DynamicResource Text.Icon}" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Margin="18,6,10,0"
                   Visibility="{Binding ShowExplorer, Converter={x:Static app:Converters.TrueToCollapsed}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
                    <Setter Property="Text" Value="SAVED QUERIES" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHistoryPanel}" Value="True">
                            <Setter Property="Text" Value="HISTORY" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <DockPanel Grid.Row="1">
            <Grid DockPanel.Dock="Top" Margin="10,8,10,10" Visibility="{Binding ShowExplorer, Converter={x:Static app:Converters.BoolToVisibility}}">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,52,6"
                         PreviewKeyDown="OnSearchPreviewKeyDown" AutomationProperties.Name="Search">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Setter Property="themes:Hint.Text" Value="Search connections…" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowExplorer}" Value="True">
                                    <Setter Property="themes:Hint.Text" Value="Filter tables…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="&#xE151;" Style="{DynamicResource Text.Icon}" FontSize="12" Margin="12,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        Padding="5,0,5,1" CornerRadius="{DynamicResource Radius.Small}" BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.Border.Default}" IsHitTestVisible="False">
                    <TextBlock Text="Ctrl K" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText.Length}" Value="0">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                    <Setter Property="Opacity" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

            <Border themes:Fade.OnShow="True" DockPanel.Dock="Bottom" Margin="10,0,10,10" Padding="12,8" CornerRadius="{DynamicResource Radius.Medium}"
                    Background="{DynamicResource Brush.Bg.Hover}"
                    Visibility="{Binding ConnectCommand.IsRunning, Converter={x:Static app:Converters.BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource Button.Link}" FontSize="12" Padding="2,0"
                            Content="Stop" Command="{Binding ConnectCancelCommand}" ToolTip="Cancel connecting" />
                    <controls:Spinner Width="12" Height="12" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </DockPanel>
            </Border>

            <Grid>
                <DockPanel themes:Fade.OnShow="True" Visibility="{Binding ShowExplorer, Converter={x:Static app:Converters.BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Top" Margin="18,0,14,8" Text="{Binding ExplorerError}" ToolTip="{Binding ExplorerError}"
                               FontSize="12" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Danger}"
                               Visibility="{Binding ExplorerError, Converter={x:Static app:Converters.NullToCollapsed}}" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,10"
                                Visibility="{Binding HasDatabasePicker, Converter={x:Static app:Converters.TrueToCollapsed}}">
                        <Border Height="1" Margin="16,0,16,6" Background="{DynamicResource Brush.Border.Subtle}" />
                        <ToggleButton x:Name="ViewsToggle" Style="{StaticResource SectionToggle}" Content="Views" Tag="{Binding Views.Count}" />
                        <TreeView themes:Fade.OnShow="True" x:Name="ViewList" ItemsSource="{Binding Lists.FilteredViews, RelativeSource={RelativeSource AncestorType=Window}}" MaxHeight="260" Padding="4,0,8,0"
                                  ContextMenu="{StaticResource ObjectMenu}" ContextMenuOpening="OnObjectMenuOpening"
                                  PreviewMouseLeftButtonDown="OnObjectMouseDown" PreviewMouseRightButtonDown="OnObjectRightButtonDown"
                                  PreviewKeyDown="OnObjectKeyDown" AutomationProperties.Name="Views"
                                  Visibility="{Binding IsChecked, ElementName=ViewsToggle, Converter={x:Static app:Converters.BoolToVisibility}}" />
                        <ToggleButton Style="{StaticResource SectionToggle}" Content="Functions"
                                      IsChecked="{Binding FunctionsSection.IsExpanded, Mode=TwoWay}" Tag="{Binding FunctionsSection.LoadedCount}"
                                      Visibility="{Binding FunctionsSection, Converter={x:Static app:Converters.NullToCollapsed}}" />
                        <TreeView themes:Fade.OnShow="True" ItemsSource="{Binding FunctionsSection.Children}" MaxHeight="260" Padding="4,0,8,0"
                                  ContextMenu="{StaticResource RoutineMenu}" ContextMenuOpening="OnObjectMenuOpening"
                                  PreviewMouseLeftButtonDown="OnObjectMouseDown" PreviewMouseRightButtonDown="OnObjectRightButtonDown"
                                  PreviewKeyDown="OnObjectKeyDown" AutomationProperties.Name="Functions"
                                  Visibility="{Binding FunctionsSection.IsExpanded, Converter={x:Static app:Converters.BoolToVisibility}, FallbackValue=Collapsed}" />
                        <ToggleButton Style="{StaticResource SectionToggle}" Content="Enums"
                                      IsChecked="{Binding EnumsSection.IsExpanded, Mode=TwoWay}" Tag="{Binding EnumsSection.LoadedCount}"
                                      Visibility="{Binding EnumsSection, Converter={x:Static app:Converters.NullToCollapsed}}" />
                        <TreeView themes:Fade.OnShow="True" ItemsSource="{Binding EnumsSection.Children}" MaxHeight="260" Padding="4,0,8,0"
                                  ContextMenu="{StaticResource CatalogMenu}" ContextMenuOpening="OnObjectMenuOpening"
                                  PreviewMouseLeftButtonDown="OnObjectMouseDown" PreviewMouseRightButtonDown="OnObjectRightButtonDown"
                                  PreviewKeyDown="OnObjectKeyDown" AutomationProperties.Name="Enums"
                                  Visibility="{Binding EnumsSection.IsExpanded, Converter={x:Static app:Converters.BoolToVisibility}, FallbackValue=Collapsed}" />
                        <ToggleButton Style="{StaticResource SectionToggle}" Content="Sequences"
                                      IsChecked="{Binding SequencesSection.IsExpanded, Mode=TwoWay}" Tag="{Binding SequencesSection.LoadedCount}"
                                      Visibility="{Binding SequencesSection, Converter={x:Static app:Converters.NullToCollapsed}}" />
                        <TreeView themes:Fade.OnShow="True" ItemsSource="{Binding SequencesSection.Children}" MaxHeight="260" Padding="4,0,8,0"
                                  ContextMenu="{StaticResource CatalogMenu}" ContextMenuOpening="OnObjectMenuOpening"
                                  PreviewMouseLeftButtonDown="OnObjectMouseDown" PreviewMouseRightButtonDown="OnObjectRightButtonDown"
                                  PreviewKeyDown="OnObjectKeyDown" AutomationProperties.Name="Sequences"
                                  Visibility="{Binding SequencesSection.IsExpanded, Converter={x:Static app:Converters.BoolToVisibility}, FallbackValue=Collapsed}" />
                    </StackPanel>

                    <TreeView x:Name="TableList" ItemsSource="{Binding Lists.FilteredTables, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,0,8,8"
                              ContextMenu="{StaticResource ObjectMenu}" ContextMenuOpening="OnObjectMenuOpening"
                              PreviewMouseLeftButtonDown="OnObjectMouseDown" PreviewMouseRightButtonDown="OnObjectRightButtonDown"
                              PreviewKeyDown="OnObjectKeyDown" SelectedItemChanged="OnTableSelected" AutomationProperties.Name="Tables">
                        <TreeView.InputBindings>
                            <KeyBinding Key="F5" Command="{Binding RefreshSchemaCommand}" />
                        </TreeView.InputBindings>
                    </TreeView>
                </DockPanel>

                <StackPanel themes:Fade.OnShow="True" Visibility="{Binding IsEditorPanel, Converter={x:Static app:Converters.BoolToVisibility}}" VerticalAlignment="Top" Margin="24,32,24,0">
                    <TextBlock Text="No saved queries" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>

                <DockPanel themes:Fade.OnShow="True" Visibility="{Binding IsHistoryPanel, Converter={x:Static app:Converters.BoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="12,12,8,8">
                        <Button DockPanel.Dock="Right" Style="{DynamicResource Button.Icon}" Width="28" Height="28" Margin="4,0,0,0"
                                Command="{Binding ClearConnectionHistoryCommand}" ToolTip="Clear history" AutomationProperties.Name="Clear history">
                            <TextBlock Text="&#xE18E;" Style="{DynamicResource Text.Icon}" FontSize="13" />
                        </Button>
                        <TextBox Text="{Binding HistoryFilter, UpdateSourceTrigger=PropertyChanged}" themes:Hint.Text="Search history"
                                 AutomationProperties.Name="Search history" />
                    </DockPanel>
                    <Grid>
                        <TextBlock Text="No history yet" Margin="0,24,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   Visibility="{Binding History.Count, Converter={x:Static app:Converters.NotNullToCollapsed}}" />
                        <ListBox ItemsSource="{Binding Lists.FilteredHistory, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderThickness="0" Padding="6,0,6,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                 MouseDoubleClick="OnHistoryDoubleClick" KeyDown="OnHistoryKeyDown" AutomationProperties.Name="Query history">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:HistoryEntry}">
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Sql}" FontFamily="{DynamicResource Font.Mono}" FontSize="12" MaxHeight="34"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sql}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" TextElement.FontSize="11">
                                            <TextBlock Text="{Binding Time, Converter={x:Static app:Converters.RelativeTime}}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <TextBlock Text="{Binding Milliseconds, StringFormat=' · {0} ms'}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <TextBlock x:Name="Outcome" Text="{Binding Result, StringFormat=' · {0}'}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                        </StackPanel>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                            <Setter TargetName="Outcome" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open in new query" Click="OnHistoryOpen" />
                                    <MenuItem Header="Copy SQL" Click="OnHistoryCopy" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>
        </Grid>

        <GridSplitter x:Name="SidebarSplitter" Grid.Row="1" Grid.Column="1" Width="6" Margin="0,0,-3,0" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      Background="Transparent" Focusable="False" Panel.ZIndex="1" />

        <Grid x:Name="MainPane" Grid.Column="2" Grid.RowSpan="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Border Background="{DynamicResource Brush.Bg.Rail}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border.Default}" />
        <DockPanel LastChildFill="False">
            <Button Style="{DynamicResource Button.Icon}" Width="30" Height="30" Margin="8,4,0,0" WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding ToggleSidebarCommand}" ToolTip="Toggle sidebar (Ctrl+B)" AutomationProperties.Name="Toggle sidebar">
                <TextBlock Text="&#xE12A;" Style="{DynamicResource Text.Icon}" FontSize="13" />
            </Button>

            <ListBox x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Margin="-4,0,0,0"
                     ItemContainerStyle="{StaticResource TabStripItem}" WindowChrome.IsHitTestVisibleInChrome="True"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Open tabs"
                     Visibility="{Binding Tabs.Count, Converter={x:Static app:Converters.NullToCollapsed}}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Close" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Close others" Command="{Binding CloseOtherTabsCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Close to the right" Command="{Binding CloseTabsToRightCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Close all" Command="{Binding CloseAllTabsCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="10,0" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Button Style="{DynamicResource Button.Icon}" Width="30" Height="30" Margin="4,4,0,0" WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding NewQueryCommand}" ToolTip="New SQL query (Ctrl+T)" AutomationProperties.Name="New query"
                    Visibility="{Binding ActiveConnection, Converter={x:Static app:Converters.NullToCollapsed}}">
                <TextBlock Text="&#xE13D;" Style="{DynamicResource Text.Icon}" FontSize="12" />
            </Button>
        </DockPanel>

        <Grid x:Name="ContentHost" Grid.Row="1" Background="{DynamicResource Brush.Bg.App}" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <Grid>
                <ContentControl x:Name="TabContent" Content="{Binding SelectedTab}" Focusable="False" />

                <StackPanel themes:Fade.OnShow="True" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="32"
                            Visibility="{Binding Tabs.Count, Converter={x:Static app:Converters.NotNullToCollapsed}}">
                    <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" Background="{DynamicResource Brush.Accent.Subtle}">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource Ico.Table}" Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock Margin="0,16,0,0" Text="Open a table" Style="{DynamicResource Text.Subtitle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource Brush.Bg.Rail}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Brush.Text.Secondary}">
            <DockPanel Margin="14,0">
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Run Text="{Binding SelectedTab.Caret, Mode=OneWay, FallbackValue=''}" /><Run Text="   SQL · " /><Run Text="{Binding ActiveKindName, Mode=OneWay}" /><Run Text=" dialect" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,1,6,0" Fill="{DynamicResource Brush.Success}" />
                    <TextBlock Text="Connected" />
                    <TextBlock Margin="20,0,0,0" Text="{Binding ServerVersion}" />
                    <TextBlock Margin="20,0,0,0" Text="{Binding CommitMode}" />
                </StackPanel>
            </DockPanel>
        </Border>

        </Grid>

        <views:HomeView x:Name="Home" Grid.RowSpan="2"
                        Visibility="{Binding ActiveConnection, Converter={x:Static app:Converters.NotNullToCollapsed}}" />

        <Grid x:Name="Goto" Grid.RowSpan="2" Background="Transparent" Panel.ZIndex="4" MouseDown="OnGotoBackdropMouseDown"
              Visibility="{Binding IsGotoOpen, Converter={x:Static app:Converters.BoolToVisibility}}">
            <Border Style="{DynamicResource Border.Popup}" Width="640" MaxWidth="{Binding ActualWidth, ElementName=Goto}"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,52,16,16" themes:Fade.OnShow="True">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8">
                        <TextBox x:Name="GotoBox" Text="{Binding GotoText, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,32,6"
                                 themes:Hint.Text="Go to table, view, function…" PreviewKeyDown="OnGotoKeyDown" AutomationProperties.Name="Go to object" />
                        <TextBlock Text="&#xE151;" Style="{DynamicResource Text.Icon}" FontSize="12" Margin="12,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <controls:Spinner Width="12" Height="12" Margin="0,0,12,0" HorizontalAlignment="Right"
                                          Visibility="{Binding IsGotoLoading, Converter={x:Static app:Converters.BoolToVisibility}}" />
                    </Grid>
                    <ListBox x:Name="GotoList" ItemsSource="{Binding GotoResults}" SelectedItem="{Binding GotoSelected}"
                             ItemContainerStyle="{StaticResource ListRow}" MaxHeight="420" Margin="6,0,6,6" Padding="0"
                             Background="Transparent" BorderThickness="0" Focusable="False"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="OnGotoItemClick"
                             AutomationProperties.Name="Objects"
                             Visibility="{Binding GotoResults.Count, Converter={x:Static app:Converters.NullToCollapsed}}" />
                </DockPanel>
            </Border>
        </Grid>

        <controls:ToastHost Grid.Row="1" Margin="0,0,16,12" />
        </Grid>

        <controls:SheetHost x:Name="SheetHost" Grid.RowSpan="2" Panel.ZIndex="5" Sheet="{Binding ModalSheet}" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Panel.ZIndex="6">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                    Click="OnMinimize" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                    Click="OnMaximizeRestore" AutomationProperties.Name="Maximize" />
            <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;"
                    Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close" />
        </StackPanel>
    </Grid>
</Window>
