                                                    Command="{Binding DataContext.ResetShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    ToolTip="Reset" AutomationProperties.Name="Reset shortcut" Visibility="Hidden">
                                                <TextBlock Text="&#xE148;" Style="{DynamicResource Text.Icon}" FontSize="11" Margin="0" />
                                            </Button>
                                            <Grid DockPanel.Dock="Right" Width="190" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <ItemsControl x:Name="Keys" ItemsSource="{Binding Parts}" HorizontalAlignment="Right">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
