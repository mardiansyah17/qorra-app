                                                            <Border Style="{StaticResource Key}">
                                                                <TextBlock Text="{Binding}" Margin="0" FontSize="11.5" HorizontalAlignment="Center" FontFamily="{DynamicResource Font.UI}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock x:Name="Recording" Text="Press keys…" HorizontalAlignment="Right" Margin="0" Visibility="Collapsed"
                                                           Foreground="{DynamicResource Brush.Accent}" FontSize="12.5" />
                                            </Grid>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Conflict}" Margin="0,0,10,0" FontSize="11.5" Foreground="{DynamicResource Brush.Warning}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Scope}" Width="70" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12" />
                                            <TextBlock Text="{Binding Name}" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter TargetName="Keys" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Recording" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="RowPanel" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                <Setter TargetName="ResetButton" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
