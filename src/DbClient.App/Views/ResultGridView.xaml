<UserControl x:Class="DbClient.App.Views.ResultGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:DbClient.App"
             xmlns:themes="clr-namespace:DbClient.App.Themes"
             xmlns:controls="clr-namespace:DbClient.App.Controls"
             xmlns:vm="clr-namespace:DbClient.ViewModels;assembly=DbClient.ViewModels"
             xmlns:views="clr-namespace:DbClient.App.Views"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResultTabViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="True" Sorting="OnSorting" SelectionUnit="CellOrRowHeader" SelectionMode="Extended"
                  HeadersVisibility="All"
                  ScrollViewer.ScrollChanged="OnScrollChanged" CurrentCellChanged="OnCurrentCellChanged"
                  BeginningEdit="OnBeginningEdit" PreparingCellForEdit="OnPreparingCellForEdit" CellEditEnding="OnCellEditEnding"
                  PreviewKeyDown="OnGridPreviewKeyDown" PreviewMouseRightButtonDown="OnGridRightButtonDown"
                  Visibility="{Binding ViewAs.Format, Converter={x:Static app:Converters.NotNullToCollapsed}}"
                  AutomationProperties.Name="Results">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static app:Converters.AreEqual}">
                                    <Binding />
                                    <Binding Path="DataContext.SelectedRow" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Added">
                            <Setter Property="Background" Value="{DynamicResource Brush.Success.Subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Deleted">
                            <Setter Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.RowHeaderStyle>
                <Style TargetType="DataGridRowHeader" BasedOn="{StaticResource {x:Type DataGridRowHeader}}">
                    <Setter Property="Content" Value="{Binding Number, Converter={x:Static views:ResultGridView.RowNumber}}" />
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{x:Static app:Converters.AreEqual}">
                                    <Binding />
                                    <Binding Path="DataContext.SelectedRow" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Added">
                            <Setter Property="Content" Value="+" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Deleted">
                            <Setter Property="Content" Value="−" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowHeaderStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="RecordViewItem" Header="Show record view" Click="OnShowRecordView" InputGestureText="Ctrl+Shift+R" />
                    <Separator x:Name="RecordViewSeparator" />
                    <MenuItem x:Name="GoToReferencedItem" Header="Go to referenced row" Click="OnGoToReferenced" />
                    <Separator x:Name="GoToReferencedSeparator" />
                    <MenuItem Header="Show column list" Click="OnShowColumnList" InputGestureText="Ctrl+Shift+L" />
                    <Separator />
                    <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                    <MenuItem Header="Copy with headers" Tag="TsvWithHeaders" Click="OnCopyAs" InputGestureText="Ctrl+Shift+C" />
                    <MenuItem Header="Copy as">
                        <MenuItem Header="CSV" Tag="Csv" Click="OnCopyAs" />
                        <MenuItem Header="JSON" Tag="Json" Click="OnCopyAs" />
                        <MenuItem Header="Markdown" Tag="Markdown" Click="OnCopyAs" />
                        <Separator />
                        <MenuItem Header="INSERT" Tag="Insert" Click="OnCopyAs" />
                        <MenuItem x:Name="CopyUpdateItem" Header="UPDATE" Tag="Update" Click="OnCopyAs" />
                        <MenuItem Header="IN list" Tag="InList" Click="OnCopyAs" />
                        <MenuItem Header="Column names" Tag="ColumnNames" Click="OnCopyAs" />
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="SetNullItem" Header="Set to NULL" Click="OnSetNull" InputGestureText="Ctrl+0" />
                    <MenuItem x:Name="AddRowItem" Header="Add row" Click="OnAddRow" InputGestureText="Ctrl+I" />
                    <MenuItem x:Name="DeleteRowItem" Header="Delete / restore row" Click="OnDeleteRows" InputGestureText="Delete" />
                    <Separator />
                    <MenuItem Header="Export…" Click="OnExport" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <avalon:TextEditor x:Name="TextView" IsReadOnly="True" ShowLineNumbers="True" Padding="6,4"
                           FontFamily="{DynamicResource Font.Mono}" FontSize="12.5"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                           Visibility="{Binding ViewAs.Format, Converter={x:Static app:Converters.NullToCollapsed}}"
                           AutomationProperties.Name="Results as text" />

        <Border x:Name="ColumnFlash" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0"
                Background="{DynamicResource Brush.Accent.Subtle}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.5,0" />

        <Popup x:Name="ColumnPopup" PlacementTarget="{Binding ElementName=Grid}" Placement="Relative" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="OnColumnPopupOpened">
            <Border Style="{DynamicResource Border.Popup}" Width="320" Margin="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="8">
                        <TextBox x:Name="ColumnSearch" Padding="30,5,10,5" themes:Hint.Text="Find column…"
                                 TextChanged="OnColumnSearchChanged" PreviewKeyDown="OnColumnSearchKeyDown" AutomationProperties.Name="Find column" />
                        <TextBlock Text="&#xE151;" Style="{DynamicResource Text.Icon}" FontSize="12" Margin="11,0,0,0"
                                   HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </Grid>
                    <TextBlock x:Name="ColumnEmpty" DockPanel.Dock="Top" Text="No matching columns" Style="{DynamicResource Text.Muted}"
                               Margin="16,4,16,14" Visibility="Collapsed" />
                    <ListBox x:Name="ColumnList" ItemContainerStyle="{StaticResource ListRow}" MaxHeight="360" Margin="6,0,6,6" Padding="0"
                             Background="Transparent" BorderThickness="0" Focusable="False"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="OnColumnItemClick"
                             AutomationProperties.Name="Columns">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel MinHeight="26">
                                    <TextBlock DockPanel.Dock="Left" Width="22" Text="{Binding Glyph}" Style="{DynamicResource Text.Icon}" FontSize="12"
                                               HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Icon.Column}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Type}" Margin="12,0,4,0" FontSize="11" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>

        <TextBlock Text="No rows" themes:Fade.OnShow="True" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Rows.Count}" Value="0" />
                                <Condition Binding="{Binding HasMore}" Value="False" />
                                <Condition Binding="{Binding LoadMoreCommand.IsRunning}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Columns}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border x:Name="Footer" Grid.Row="1" MinHeight="38" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}">
            <Grid Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:Spinner Width="12" Height="12" Margin="0,0,8,0"
                                      Visibility="{Binding LoadMoreCommand.IsRunning, Converter={x:Static app:Converters.BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock themes:Fade.OnShow="True" Grid.Column="1" Margin="16,0" Text="{Binding Error}" ToolTip="{Binding Error}" VerticalAlignment="Center"
                           Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Error, Converter={x:Static app:Converters.NullToCollapsed}}" />

                <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:ResultView.All}" SelectedItem="{Binding ViewAs}" MinWidth="96" Margin="0,0,6,0"
                          VerticalAlignment="Center" ToolTip="View as" AutomationProperties.Name="View as" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource Button.Ghost}" Padding="10,3" Command="{Binding LoadMoreCancelCommand}"
                            ToolTip="Stop (Esc)" AutomationProperties.Name="Stop"
                            Visibility="{Binding LoadMoreCommand.IsRunning, Converter={x:Static app:Converters.BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE167;" Style="{DynamicResource Text.Icon}" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                    <Button Padding="10,3" Command="{Binding LoadMoreCommand}" Content="Load more"
                            ToolTip="Load more">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMore}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LoadMoreCommand.IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ReloadButton" Style="{DynamicResource Button.Icon}" Width="28" Height="28" Margin="2,0,0,0" Click="OnReload"
                            ToolTip="Reload (F5)" AutomationProperties.Name="Reload rows">
                        <TextBlock Text="&#xE145;" Style="{DynamicResource Text.Icon}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding LoadMoreCancelCommand}" />
    </UserControl.InputBindings>
</UserControl>
