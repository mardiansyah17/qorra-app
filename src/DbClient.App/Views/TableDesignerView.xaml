<UserControl x:Class="DbClient.App.Views.TableDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:DbClient.App"
             xmlns:controls="clr-namespace:DbClient.App.Controls"
             xmlns:themes="clr-namespace:DbClient.App.Themes"
             xmlns:vm="clr-namespace:DbClient.ViewModels;assembly=DbClient.ViewModels"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TableDesignerViewModel}"
             Width="1000" Height="700">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ApplyCommand}" />
        <KeyBinding Gesture="Alt+Insert" Command="{Binding AddCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding MoveUpCommand}" />
        <KeyBinding Gesture="Alt+Down" Command="{Binding MoveDownCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="MonoCell" TargetType="TextBox" BasedOn="{StaticResource Cell}">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="TypeCell" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="ItemsSource" Value="{Binding DataContext.Types, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="ExistingName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="7,0,12,0" />
        </Style>

        <Style x:Key="RowShell" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="Row" Background="Transparent" MinHeight="40"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="3" Background="{DynamicResource Brush.Bg.Hover}" Opacity="0" themes:Fade.Visible="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Border x:Name="Bar" Margin="0,8" CornerRadius="1.5" Background="Transparent" />
                                <ContentPresenter x:Name="Body" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <Button x:Name="Revert" Style="{DynamicResource Button.Icon}" Width="28" Height="28" FontSize="13"
                                            Content="&#xE2A1;" ToolTip="Revert" AutomationProperties.Name="Revert" Visibility="Collapsed"
                                            Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button x:Name="Remove" Style="{DynamicResource Button.Icon}" Width="28" Height="28" FontSize="13"
                                            Content="&#xE18E;" ToolTip="Drop" AutomationProperties.Name="Drop" Opacity="0"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <themes:Fade.Visible>
                                            <MultiBinding Converter="{x:Static themes:Fade.AnyTrue}" ConverterParameter="Dropped">
                                                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="IsKeyboardFocusWithin" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="State" />
                                            </MultiBinding>
                                        </themes:Fade.Visible>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{x:Static app:Converters.AreEqual}">
                                        <Binding />
                                        <Binding Path="DataContext.SelectedColumn" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Bg.Selected}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter TargetName="Remove" Property="ToolTip" Value="Remove" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanDrop}" Value="False">
                                <Setter TargetName="Remove" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Added">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Changed">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Warning}" />
                                <Setter TargetName="Revert" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Dropped">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Danger}" />
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Danger.Subtle}" />
                                <Setter TargetName="Body" Property="Opacity" Value="0.5" />
                                <Setter TargetName="Body" Property="IsEnabled" Value="False" />
                                <Setter TargetName="Remove" Property="Content" Value="&#xE2A1;" />
                                <Setter TargetName="Remove" Property="ToolTip" Value="Restore" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Content" Value="&#xE06D;" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="ToolTip" Value="Pick columns" />
            <Setter Property="AutomationProperties.Name" Value="Pick columns" />
        </Style>
        <Style x:Key="PlainCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="KeyToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="22" Height="22" CornerRadius="{DynamicResource Radius.Small}" x:Name="Bd">
                            <TextBlock x:Name="Glyph" Text="&#xE4A3;" Style="{DynamicResource Text.Icon}" FontSize="12" Opacity="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.6" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Pressed}" />
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowList" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Empty" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="SectionTab" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" Margin="0,0,22,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                <Border x:Name="Count" Margin="7,0,0,0" Padding="6,1" CornerRadius="8" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Bg.Hover}"
                                        Visibility="{Binding Rows, Converter={x:Static app:Converters.NullToCollapsed}}">
                                    <TextBlock Text="{Binding Rows.Count}" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </Border>
                            </StackPanel>
                            <Border x:Name="Underline" Height="2" CornerRadius="1" VerticalAlignment="Bottom"
                                    Background="{DynamicResource Brush.Accent}" Opacity="0" themes:Fade.Visible="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                <Setter TargetName="Count" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,20,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.Accent.Subtle}" VerticalAlignment="Center">
                <TextBlock Text="&#xE17D;" Style="{DynamicResource Text.Icon}" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="NameBox" Style="{StaticResource Cell}" Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="18" FontWeight="SemiBold" MinHeight="32" HorizontalAlignment="Left" MinWidth="220"
                         themes:Hint.Text="Table name" AutomationProperties.Name="Table name" />
                <TextBlock Margin="7,1,0,0" Style="{DynamicResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}">
                    <Run Text="{Binding Schema, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding KindName, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <TextBox Grid.Column="1" Width="300" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                     Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" themes:Hint.Text="Comment" AutomationProperties.Name="Table comment"
                     Visibility="{Binding HasComments, Converter={x:Static app:Converters.BoolToVisibility}}" />
            <Button Grid.Column="2" Style="{DynamicResource Button.Icon}" Content="&#xE1B2;" FontSize="12" VerticalAlignment="Top"
                    Command="{Binding CancelCommand}" ToolTip="Close (Esc)" AutomationProperties.Name="Close" />
        </Grid>

        <Grid Grid.Row="1" Margin="24,20,24,0">
            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Border.Subtle}" />
            <ListBox ItemsSource="{Binding Tabs}" SelectedValuePath="Name" SelectedValue="{Binding Section}"
                     ItemContainerStyle="{StaticResource SectionTab}" Background="Transparent" BorderThickness="0"
                     HorizontalAlignment="Left" AutomationProperties.Name="Sections">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0" Style="{DynamicResource Button.Ghost}"
                    Command="{Binding AddCommand}" ToolTip="Alt+Insert"
                    Visibility="{Binding CanAdd, Converter={x:Static app:Converters.BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE13D;" Style="{DynamicResource Text.Icon}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AddText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,0">
            <Grid>
                <Grid.Visibility>
                    <MultiBinding Converter="{x:Static app:Converters.AreEqual}">
                        <Binding Path="Section" />
                        <Binding Source="Columns" />
                    </MultiBinding>
                </Grid.Visibility>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Height="34" Margin="9,0,64,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="3" Text="NULL" Style="{StaticResource HeaderText}" HorizontalAlignment="Center" Margin="0" ToolTip="Nullable" />
                    <TextBlock Grid.Column="4" Text="AUTO" Style="{StaticResource HeaderText}" HorizontalAlignment="Center" Margin="0" ToolTip="Auto increment" />
                    <TextBlock Grid.Column="5" Text="UQ" Style="{StaticResource HeaderText}" HorizontalAlignment="Center" Margin="0" ToolTip="Unique" />
                    <TextBlock Grid.Column="6" Text="DEFAULT" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="7" Text="COMMENT" Style="{StaticResource HeaderText}" Width="172" Visibility="{Binding HasComments, Converter={x:Static app:Converters.BoolToVisibility}}" />
                </Grid>
                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Border.Subtle}" />
                <ItemsControl x:Name="ColumnsList" Grid.Row="1" ItemsSource="{Binding Columns}" Style="{StaticResource RowList}"
                              PreviewGotKeyboardFocus="OnColumnFocus" PreviewMouseLeftButtonDown="OnColumnFocus">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource RowShell}" Content="{Binding}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton IsChecked="{Binding IsPrimaryKey}" Style="{StaticResource KeyToggle}"
                                                          ToolTip="Primary key" AutomationProperties.Name="Primary key" />
                                            <TextBox x:Name="NameCell" Grid.Column="1" Style="{StaticResource Cell}"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     themes:Hint.Text="name" AutomationProperties.Name="Column name" />
                                            <ComboBox Grid.Column="2" Style="{StaticResource TypeCell}"
                                                      Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                      themes:Hint.Text="type" AutomationProperties.Name="Type" />
                                            <CheckBox Grid.Column="3" IsChecked="{Binding IsNullable}" HorizontalAlignment="Center"
                                                      ToolTip="Nullable" AutomationProperties.Name="Nullable" />
                                            <CheckBox Grid.Column="4" IsChecked="{Binding IsAutoIncrement}" HorizontalAlignment="Center"
                                                      ToolTip="Auto increment" AutomationProperties.Name="Auto increment" />
                                            <CheckBox Grid.Column="5" IsChecked="{Binding ColumnUnique}" HorizontalAlignment="Center"
                                                      ToolTip="Unique (adds a unique index)" AutomationProperties.Name="Unique" />
                                            <TextBox x:Name="DefaultCell" Grid.Column="6" Style="{StaticResource MonoCell}"
                                                     Text="{Binding Default, UpdateSourceTrigger=PropertyChanged}"
                                                     themes:Hint.Text="NULL" AutomationProperties.Name="Default" />
                                            <TextBox Grid.Column="7" Style="{StaticResource Cell}" Width="172" Visibility="{Binding DataContext.HasComments, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static app:Converters.BoolToVisibility}}"
                                                     Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Column comment" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDropped}" Value="True">
                                                <Setter TargetName="NameCell" Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:Spinner Grid.Row="1" Width="20" Height="20"
                                  Visibility="{Binding IsLoading, Converter={x:Static app:Converters.BoolToVisibility}}" />

                <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8" CornerRadius="{DynamicResource Radius.Large}"
                        Background="{DynamicResource Brush.Bg.Input}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        DataContext="{Binding SelectedColumn}"
                        Visibility="{Binding Converter={x:Static app:Converters.NullToCollapsed}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="COLLATION" Style="{StaticResource HeaderText}" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource MonoCell}" Text="{Binding Collation, UpdateSourceTrigger=PropertyChanged}"
                                 themes:Hint.Text="default" AutomationProperties.Name="Collation" />
                        <TextBlock Grid.Column="2" Text="GENERATED AS" Style="{StaticResource HeaderText}" Margin="8,0,8,0"
                                   ToolTip="Computed column: the value comes from this expression" />
                        <TextBox Grid.Column="3" Style="{StaticResource MonoCell}" Text="{Binding Generated, UpdateSourceTrigger=PropertyChanged}"
                                 themes:Hint.Text="price * qty" AutomationProperties.Name="Generated expression" />
                        <CheckBox Grid.Column="4" Content="Stored" IsChecked="{Binding IsStored}" Margin="0,0,12,0" VerticalAlignment="Center"
                                  ToolTip="Store the value (otherwise computed on read)"
                                  Visibility="{Binding DataContext.HasVirtualColumns, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static app:Converters.BoolToVisibility}}" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                    Visibility="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static app:Converters.BoolToVisibility}}">
                            <Button Style="{DynamicResource Button.Icon}" Width="28" Height="28" FontSize="12" Content="&#xE070;"
                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Move up (Alt+Up)" AutomationProperties.Name="Move up" />
                            <Button Style="{DynamicResource Button.Icon}" Width="28" Height="28" FontSize="12" Content="&#xE06D;"
                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Move down (Alt+Down)" AutomationProperties.Name="Move down" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid>
                <Grid.Visibility>
                    <MultiBinding Converter="{x:Static app:Converters.AreEqual}">
                        <Binding Path="Section" />
                        <Binding Source="Indexes" />
                    </MultiBinding>
                </Grid.Visibility>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Height="34" Margin="9,0,64,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="2" Text="COLUMNS" Style="{StaticResource HeaderText}" ToolTip="Comma-separated; add DESC for descending" />
                    <TextBlock Grid.Column="3" Text="METHOD" Style="{StaticResource HeaderText}" Width="112" Visibility="{Binding HasIndexMethods, Converter={x:Static app:Converters.BoolToVisibility}}" />
                    <TextBlock Grid.Column="4" Text="WHERE" Style="{StaticResource HeaderText}" Width="212" ToolTip="Partial index condition" Visibility="{Binding HasPartialIndexes, Converter={x:Static app:Converters.BoolToVisibility}}" />
                </Grid>
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Border.Subtle}" />
                <ItemsControl x:Name="IndexesList" Grid.Row="1" ItemsSource="{Binding Indexes}" Style="{StaticResource RowList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource RowShell}" Content="{Binding}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid IsEnabled="{Binding CanEdit}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="76" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Icon" Text="&#xE106;" Style="{StaticResource Glyph}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     themes:Hint.Text="index_name" AutomationProperties.Name="Index name" />
                                            <TextBox Grid.Column="2" Style="{StaticResource MonoCell}" Text="{Binding Columns, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="6,0,26,0" themes:Hint.Text="column, column DESC" AutomationProperties.Name="Columns" />
                                            <Button Grid.Column="2" Style="{StaticResource PickButton}" Tag="Columns" Click="OnPickColumns" />
                                            <ComboBox Grid.Column="3" Style="{StaticResource PlainCombo}" IsEditable="True" Width="104" Visibility="{Binding DataContext.HasIndexMethods, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static app:Converters.BoolToVisibility}}"
                                                      ItemsSource="{Binding DataContext.IndexMethods, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Text="{Binding Method, UpdateSourceTrigger=PropertyChanged}" themes:Hint.Text="default"
                                                      AutomationProperties.Name="Index method" />
                                            <TextBox Grid.Column="4" Style="{StaticResource MonoCell}" Width="204" Visibility="{Binding DataContext.HasPartialIndexes, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static app:Converters.BoolToVisibility}}" Text="{Binding Where, UpdateSourceTrigger=PropertyChanged}"
                                                     themes:Hint.Text="deleted_at IS NULL" AutomationProperties.Name="Where" />
                                            <CheckBox Grid.Column="5" Content="Unique" IsChecked="{Binding IsUnique}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPrimaryKey}" Value="True">
                                                <Setter TargetName="Icon" Property="Text" Value="&#xE4A3;" />
                                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="1" Text="No indexes" Style="{StaticResource Empty}"
                           Visibility="{Binding HasItems, ElementName=IndexesList, Converter={x:Static app:Converters.TrueToCollapsed}}" />
            </Grid>

            <Grid>
                <Grid.Visibility>
                    <MultiBinding Converter="{x:Static app:Converters.AreEqual}">
                        <Binding Path="Section" />
                        <Binding Source="Foreign keys" />
                    </MultiBinding>
                </Grid.Visibility>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Height="34" Margin="9,0,64,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="2" Text="COLUMNS" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="4" Text="REFERENCES" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="5" Text="REF COLUMNS" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="6" Text="ON UPDATE" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="7" Text="ON DELETE" Style="{StaticResource HeaderText}" />
                </Grid>
                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Border.Subtle}" />
                <ItemsControl x:Name="ForeignKeysList" Grid.Row="1" ItemsSource="{Binding ForeignKeys}" Style="{StaticResource RowList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource RowShell}" Content="{Binding}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="104" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE102;" Style="{StaticResource Glyph}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     themes:Hint.Text="fk_name (optional)" AutomationProperties.Name="Foreign key name" />
                                            <TextBox Grid.Column="2" Style="{StaticResource MonoCell}" Text="{Binding Columns, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="6,0,26,0" themes:Hint.Text="column" AutomationProperties.Name="Columns" />
                                            <Button Grid.Column="2" Style="{StaticResource PickButton}" Tag="Columns" Click="OnPickColumns" />
                                            <TextBlock Grid.Column="3" Text="&#xE049;" Style="{StaticResource Glyph}" />
                                            <ComboBox Grid.Column="4" Style="{StaticResource PlainCombo}" IsEditable="True" FontFamily="{DynamicResource Font.Mono}"
                                                      ItemsSource="{Binding DataContext.TableChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Text="{Binding RefTable, UpdateSourceTrigger=PropertyChanged}" themes:Hint.Text="ref_table"
                                                      AutomationProperties.Name="Referenced table" />
                                            <TextBox Grid.Column="5" Style="{StaticResource MonoCell}" Text="{Binding RefColumns, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="6,0,26,0" themes:Hint.Text="id" AutomationProperties.Name="Referenced columns" />
                                            <Button Grid.Column="5" Style="{StaticResource PickButton}" Tag="RefColumns" Click="OnPickColumns" />
                                            <ComboBox Grid.Column="6" Style="{StaticResource PlainCombo}" SelectedItem="{Binding OnUpdate}"
                                                      ItemsSource="{Binding DataContext.ForeignKeyActions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      AutomationProperties.Name="On update" />
                                            <ComboBox Grid.Column="7" Style="{StaticResource PlainCombo}" SelectedItem="{Binding OnDelete}"
                                                      ItemsSource="{Binding DataContext.ForeignKeyActions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      AutomationProperties.Name="On delete" />
                                        </Grid>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="1" Text="No foreign keys" Style="{StaticResource Empty}"
                           Visibility="{Binding HasItems, ElementName=ForeignKeysList, Converter={x:Static app:Converters.TrueToCollapsed}}" />
            </Grid>

            <Grid>
                <Grid.Visibility>
                    <MultiBinding Converter="{x:Static app:Converters.AreEqual}">
                        <Binding Path="Section" />
                        <Binding Source="Checks" />
                    </MultiBinding>
                </Grid.Visibility>
                <ItemsControl x:Name="ChecksList" ItemsSource="{Binding Checks}" Style="{StaticResource RowList}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource RowShell}" Content="{Binding}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="2.2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE06C;" Style="{StaticResource Glyph}" />
                                            <TextBox Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     themes:Hint.Text="check_name (optional)" AutomationProperties.Name="Check name" />
                                            <TextBox Grid.Column="2" Style="{StaticResource MonoCell}" Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                     themes:Hint.Text="price &gt; 0" AutomationProperties.Name="Expression" />
                                        </Grid>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No checks" Style="{StaticResource Empty}"
                           Visibility="{Binding HasItems, ElementName=ChecksList, Converter={x:Static app:Converters.TrueToCollapsed}}" />
            </Grid>

            <Grid>
                <Grid.Visibility>
                    <MultiBinding Converter="{x:Static app:Converters.AreEqual}">
                        <Binding Path="Section" />
                        <Binding Source="Triggers" />
                    </MultiBinding>
                </Grid.Visibility>
                <ItemsControl x:Name="TriggersList" ItemsSource="{Binding Triggers}" Style="{StaticResource RowList}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource RowShell}" Content="{Binding}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE1B4;" Style="{StaticResource Glyph}" VerticalAlignment="Top" Margin="0,7,0,0" />
                                            <TextBox Grid.Column="1" Style="{StaticResource MonoCell}" Text="{Binding Definition, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" MinHeight="60" MaxHeight="180"
                                                     VerticalContentAlignment="Top" Padding="6,4"
                                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.Name="Trigger definition" />
                                        </Grid>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No triggers" Style="{StaticResource Empty}"
                           Visibility="{Binding HasItems, ElementName=TriggersList, Converter={x:Static app:Converters.TrueToCollapsed}}" />
            </Grid>

            <StackPanel Margin="0,16,0,0">
                <StackPanel.Visibility>
                    <MultiBinding Converter="{x:Static app:Converters.AreEqual}">
                        <Binding Path="Section" />
                        <Binding Source="Options" />
                    </MultiBinding>
                </StackPanel.Visibility>
                <Grid Visibility="{Binding IsMySql, Converter={x:Static app:Converters.BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Engine" Style="{DynamicResource Text.Body}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{x:Static vm:TableDesignerViewModel.Engines}"
                              Text="{Binding Engine, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Engine" />
                    <TextBlock Grid.Row="1" Text="Default collation" Style="{DynamicResource Text.Body}" VerticalAlignment="Center" Margin="0,10,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" FontFamily="{DynamicResource Font.Mono}"
                             Text="{Binding TableCollation, UpdateSourceTrigger=PropertyChanged}" themes:Hint.Text="utf8mb4_unicode_ci"
                             AutomationProperties.Name="Default collation" />
                </Grid>
                <StackPanel Visibility="{Binding IsMySql, Converter={x:Static app:Converters.TrueToCollapsed}}">
                    <CheckBox Content="WITHOUT ROWID" IsChecked="{Binding WithoutRowId}" ToolTip="Store rows by primary key (needs one)" />
                    <CheckBox Content="STRICT" IsChecked="{Binding Strict}" Margin="0,10,0,0" ToolTip="Reject values that don't match the column type" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="24,16,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{DynamicResource Button.Icon}" Width="28" Height="28" FontSize="13" Content="&#xE09E;"
                            Command="{Binding CopySqlCommand}" ToolTip="Copy SQL" AutomationProperties.Name="Copy SQL" />
                    <Button Style="{DynamicResource Button.Icon}" Width="28" Height="28" FontSize="13" Content="&#xE426;" Margin="2,0,0,0"
                            Command="{Binding OpenInEditorCommand}" ToolTip="Open in editor" AutomationProperties.Name="Open in editor" />
                </StackPanel>
                <TextBlock Text="SQL" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.Accent.Subtle}"
                        Visibility="{Binding HasStatements, Converter={x:Static app:Converters.BoolToVisibility}}">
                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Accent}">
                        <Run Text="{Binding StatementCount, Mode=OneWay}" /><Run Text=" pending" />
                    </TextBlock>
                </Border>
            </DockPanel>
            <Border Grid.Row="1" CornerRadius="{DynamicResource Radius.Large}" BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}" Background="{DynamicResource Brush.Bg.Input}">
                <Grid>
                    <ae:TextEditor x:Name="Sql" IsReadOnly="True" Padding="12,10" Background="Transparent" BorderThickness="0"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="12.5" WordWrap="False"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                   AutomationProperties.Name="SQL preview" />
                    <TextBlock Text="No changes" Style="{StaticResource Empty}"
                               Visibility="{Binding HasStatements, Converter={x:Static app:Converters.TrueToCollapsed}}" />
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="24,16,24,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cancel" MinWidth="88" Command="{Binding CancelCommand}" ToolTip="Esc" />
                <Button MinWidth="96" Margin="8,0,0,0" Command="{Binding ApplyCommand}" ToolTip="Ctrl+Enter" Style="{DynamicResource Button.Primary}"
                        Visibility="{Binding DropsData, Converter={x:Static app:Converters.TrueToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                        <controls:Spinner Width="12" Height="12" Margin="0,0,8,0"
                                          Visibility="{Binding IsApplying, Converter={x:Static app:Converters.BoolToVisibility}}" />
                        <TextBlock Text="{Binding ApplyText}" />
                    </StackPanel>
                </Button>
                <Button MinWidth="96" Margin="8,0,0,0" Command="{Binding ApplyCommand}" ToolTip="Drops column data (Ctrl+Enter)" Style="{DynamicResource Button.Danger}"
                        Visibility="{Binding DropsData, Converter={x:Static app:Converters.BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <controls:Spinner Width="12" Height="12" Margin="0,0,8,0"
                                          Visibility="{Binding IsApplying, Converter={x:Static app:Converters.BoolToVisibility}}" />
                        <TextBlock Text="{Binding ApplyText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding Problem, Converter={x:Static app:Converters.NullToCollapsed}}">
                <TextBlock Text="&#xE077;" Style="{DynamicResource Text.Icon}" FontSize="13" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Problem}" Margin="8,0,16,0" FontSize="12.5" Foreground="{DynamicResource Brush.Danger}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="640"
                           ToolTip="{Binding Problem}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
