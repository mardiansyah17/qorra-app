<UserControl x:Class="DbClient.App.Views.TableTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:DbClient.App"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:controls="clr-namespace:DbClient.App.Controls"
             xmlns:themes="clr-namespace:DbClient.App.Themes"
             xmlns:views="clr-namespace:DbClient.App.Views"
             xmlns:vm="clr-namespace:DbClient.ViewModels;assembly=DbClient.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TableTabViewModel}">
    <UserControl.Resources>
        <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        </Style>

        <Style x:Key="ToolGlyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ToolGlyph.Tint" TargetType="TextBlock" BasedOn="{StaticResource ToolGlyph}">
            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="7,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border.Default}" />
        </Style>

        <Style x:Key="ClauseKeyword" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>

        <Style x:Key="ClauseBox" TargetType="avalon:TextEditor">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ShowLineNumbers" Value="False" />
            <Setter Property="WordWrap" Value="False" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="ClauseClear" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="4,0,4,0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Content">
                <Setter.Value>
                    <TextBlock Text="&#xE1B2;" Style="{DynamicResource Text.Icon}" FontSize="10" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border.Subtle}">
            <DockPanel Margin="8,4,10,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:Spinner Width="12" Height="12" Margin="0,0,8,0"
                                      Visibility="{Binding LoadMoreCommand.IsRunning, Converter={x:Static app:Converters.BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Estimate}" FontSize="12.5" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Estimated from table statistics"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" Visibility="{Binding Estimate, Converter={x:Static app:Converters.NullToCollapsed}}" />
                    <Button Style="{StaticResource Tool}" Click="OnExport" ToolTip="Export" AutomationProperties.Name="Export" Margin="0,0,6,0">
                        <TextBlock Text="&#xE0B2;" Style="{StaticResource ToolGlyph}" />
                    </Button>
                    <ComboBox ItemsSource="{x:Static vm:ResultView.All}" SelectedItem="{Binding ViewAs}" MinWidth="96" Margin="0,0,6,0"
                              ToolTip="View as" AutomationProperties.Name="View as" />
                    <ComboBox ItemsSource="{x:Static vm:TableTabViewModel.Limits}" SelectedItem="{Binding Limit}" MinWidth="76" Margin="0,0,6,0"
                              ToolTip="Rows per page" AutomationProperties.Name="Rows per page" />
                    <Button Style="{StaticResource Tool}" Command="{Binding PreviousPageCommand}" ToolTip="Previous page" AutomationProperties.Name="Previous page">
                        <TextBlock Text="&#xE06E;" Style="{StaticResource ToolGlyph}" FontSize="11" />
                    </Button>
                    <TextBox Text="{Binding Page, Mode=OneWay}" Width="48" Padding="4,3" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                             PreviewTextInput="OnPageTextInput" KeyDown="OnPageKeyDown" LostKeyboardFocus="OnPageLostFocus"
                             ToolTip="Page (Enter to go)" AutomationProperties.Name="Page" />
                    <Button Style="{StaticResource Tool}" Command="{Binding NextPageCommand}" ToolTip="Next page" AutomationProperties.Name="Next page">
                        <TextBlock Text="&#xE06F;" Style="{StaticResource ToolGlyph}" FontSize="11" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Tool}" Click="OnReload" ToolTip="Reload (F5)" AutomationProperties.Name="Reload rows">
                        <TextBlock Text="&#xE145;" Style="{StaticResource ToolGlyph.Tint}" Tag="{DynamicResource Brush.Icon.Object}" />
                    </Button>
                    <Button Style="{StaticResource Tool}" Command="{Binding LoadMoreCancelCommand}" ToolTip="Stop loading (Esc)" AutomationProperties.Name="Stop">
                        <TextBlock Text="&#xE167;" Style="{StaticResource ToolGlyph.Tint}" Tag="{DynamicResource Brush.Danger}" FontSize="12" />
                    </Button>
                    <Border Style="{StaticResource ToolSeparator}" />

                    <Button Style="{StaticResource Tool}" Click="OnAddRow" IsEnabled="{Binding CanEdit}" ToolTip="Add row (Ctrl+I)" AutomationProperties.Name="Add row">
                        <TextBlock Text="&#xE13D;" Style="{StaticResource ToolGlyph.Tint}" Tag="{DynamicResource Brush.Success}" />
                    </Button>
                    <Button Style="{StaticResource Tool}" Click="OnDeleteRows" IsEnabled="{Binding CanEdit}" ToolTip="Delete / restore selected rows (Delete)"
                            AutomationProperties.Name="Delete rows">
                        <TextBlock Text="&#xE11C;" Style="{StaticResource ToolGlyph.Tint}" Tag="{DynamicResource Brush.Danger}" />
                    </Button>
                    <Button Style="{StaticResource Tool}" Click="OnSetNull" IsEnabled="{Binding CanEdit}" ToolTip="Set selected cells to NULL (Ctrl+0)"
                            AutomationProperties.Name="Set to NULL">
                        <TextBlock Text="NULL" FontFamily="{DynamicResource Font.Mono}" FontSize="9.5" FontWeight="SemiBold" />
                    </Button>
                    <Border Style="{StaticResource ToolSeparator}" />

                    <Button Style="{StaticResource Tool}" Command="{Binding DiscardCommand}" ToolTip="Revert all changes" AutomationProperties.Name="Revert changes">
                        <TextBlock Text="&#xE2A1;" Style="{StaticResource ToolGlyph.Tint}" Tag="{DynamicResource Brush.Pending}" />
                    </Button>
                    <Button Click="OnCommit" IsEnabled="{Binding HasChanges}" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save changes">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Tool}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Pending}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <TextBlock Text="&#xE14D;" Style="{StaticResource ToolGlyph}"
                                       Visibility="{Binding SaveCommand.IsRunning, Converter={x:Static app:Converters.TrueToCollapsed}}" />
                            <controls:Spinner Width="13" Height="13" Stroke="{DynamicResource Brush.Pending}"
                                              Visibility="{Binding SaveCommand.IsRunning, Converter={x:Static app:Converters.BoolToVisibility}}" />
                        </Grid>
                    </Button>
                    <TextBlock themes:Fade.OnShow="True" Text="{Binding PendingText}" Margin="4,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Pending}"
                               Visibility="{Binding HasChanges, Converter={x:Static app:Converters.BoolToVisibility}}" />
                    <Border Style="{StaticResource ToolSeparator}" />

                    <Button Style="{StaticResource Tool}" Click="OnToggleRecordView" ToolTip="Record view (Ctrl+Shift+R)" AutomationProperties.Name="Record view">
                        <TextBlock Text="&#xE431;" Style="{StaticResource ToolGlyph}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="FilterBar" Grid.Row="1" Height="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="140" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border.Subtle}" />

            <DockPanel>
                <TextBlock Text="&#xE0DC;" Style="{DynamicResource Text.Icon}" FontSize="12" Margin="12,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBlock Text="WHERE" Style="{StaticResource ClauseKeyword}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ClauseClear}" Command="{Binding ClearWhereCommand}"
                        ToolTip="Clear the filter" AutomationProperties.Name="Clear WHERE"
                        Visibility="{Binding WhereText.Length, Converter={x:Static app:Converters.NullToCollapsed}}" />
                <avalon:TextEditor x:Name="WhereBox" Style="{StaticResource ClauseBox}" AutomationProperties.Name="WHERE condition" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" Margin="-2,0" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext"
                          Focusable="False" Panel.ZIndex="1" />
            <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border.Subtle}" IsHitTestVisible="False" />

            <DockPanel Grid.Column="2">
                <TextBlock Text="&#xE37D;" Style="{DynamicResource Text.Icon}" FontSize="12" Margin="12,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <TextBlock Text="ORDER BY" Style="{StaticResource ClauseKeyword}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ClauseClear}" Command="{Binding ClearOrderByCommand}"
                        ToolTip="Clear the sort" AutomationProperties.Name="Clear ORDER BY"
                        Visibility="{Binding OrderByText.Length, Converter={x:Static app:Converters.NullToCollapsed}}" />
                <avalon:TextEditor x:Name="OrderBox" Style="{StaticResource ClauseBox}" AutomationProperties.Name="ORDER BY expression" />
            </DockPanel>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="12,6,12,6" Orientation="Horizontal">
            <WrapPanel.Style>
                <Style TargetType="WrapPanel">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Error}" Value="{x:Null}" />
                                <Condition Binding="{Binding ReadOnlyReason}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </WrapPanel.Style>
            <TextBlock themes:Fade.OnShow="True" Text="{Binding ReadOnlyReason}" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12.5"
                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                       Visibility="{Binding ReadOnlyReason, Converter={x:Static app:Converters.NullToCollapsed}}" />
            <TextBlock themes:Fade.OnShow="True" Text="{Binding Error}" ToolTip="{Binding Error}" VerticalAlignment="Center" FontSize="12.5" MaxWidth="900"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Danger}"
                       Visibility="{Binding Error, Converter={x:Static app:Converters.NullToCollapsed}}" />
        </WrapPanel>

        <Grid Grid.Row="3" Background="{DynamicResource Brush.Bg.App}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="240" />
                    <ColumnDefinition x:Name="RecordColumn" Width="0" MaxWidth="560" />
                </Grid.ColumnDefinitions>

                <views:ResultGridView x:Name="Results" />

                <GridSplitter x:Name="RecordSplitter" Grid.Column="1" Width="6" Visibility="Collapsed" Margin="-3,0,0,0" HorizontalAlignment="Left" Background="Transparent"
                              Focusable="False" Panel.ZIndex="1" />
                <Border x:Name="RecordPanel" Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" Visibility="Collapsed"
                        Background="{DynamicResource Brush.Bg.Sidebar}">
                    <Grid>
                        <StackPanel themes:Fade.OnShow="True" VerticalAlignment="Center" Margin="24"
                                    Visibility="{Binding SelectedRow, Converter={x:Static app:Converters.NotNullToCollapsed}}">
                            <TextBlock Text="&#xE431;" Style="{DynamicResource Text.Icon}" FontSize="18" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            <TextBlock Margin="0,10,0,0" Text="No row selected" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </StackPanel>

                        <DockPanel themes:Fade.OnShow="True" Visibility="{Binding SelectedRow, Converter={x:Static app:Converters.NullToCollapsed}}">
                            <Grid DockPanel.Dock="Top" Margin="16,14,12,12">
                                <StackPanel Margin="0,0,70,0">
                                    <TextBlock Text="{Binding InspectorTitle}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding InspectorSubtitle}" Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                                    <Button Style="{DynamicResource Button.Icon}" Width="30" Height="30"
                                            Click="OnCopyRow" ToolTip="Copy row" AutomationProperties.Name="Copy row">
                                        <TextBlock Text="&#xE09E;" Style="{DynamicResource Text.Icon}" FontSize="12" />
                                    </Button>
                                    <Button Style="{DynamicResource Button.Icon}" Width="30" Height="30" Margin="2,0,0,0"
                                            Click="OnCloseRecordView" ToolTip="Close record view (Ctrl+Shift+R)" AutomationProperties.Name="Close record view">
                                        <TextBlock Text="&#xE1B2;" Style="{DynamicResource Text.Icon}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border.Subtle}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="16,12,14,16">
                                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:InspectorField}">
                                                <StackPanel Margin="0,0,0,12">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock x:Name="Was" DockPanel.Dock="Right" FontSize="11.5" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Brush.Pending}" Visibility="Collapsed"
                                                                   Text="{Binding Was, StringFormat=was “{0}”}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="12.5" /><Run Text="  " /><Run
                                                                 Text="{Binding Type, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                                                                 Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <Border x:Name="Box" CornerRadius="{DynamicResource Radius.Medium}" BorderThickness="1" Padding="11,8"
                                                            BorderBrush="{DynamicResource Brush.Border.Default}" Background="{DynamicResource Brush.Bg.Input}">
                                                        <TextBlock x:Name="Value" Text="{Binding Value}" FontFamily="{DynamicResource Font.Mono}" FontSize="12.5"
                                                                   TextWrapping="Wrap" MaxHeight="120" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsNull}" Value="True">
                                                        <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                                        <Setter TargetName="Value" Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Pending}" />
                                                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Pending.Subtle}" />
                                                        <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Pending}" />
                                                        <Setter TargetName="Was" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding LoadMoreCancelCommand}" />
    </UserControl.InputBindings>
</UserControl>
