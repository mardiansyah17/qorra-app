<Window x:Class="DbClient.App.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Base}"
        Title="Qorra" Width="420" Height="340" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <Image Source="/Assets/logo.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Qorra is locked" Style="{DynamicResource Text.Title}" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock x:Name="Message" Style="{DynamicResource Text.Body}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Text="Unlock with Windows Hello." />
            <Button x:Name="UnlockButton" Content="Unlock" Style="{DynamicResource Button.Primary}" MinWidth="120" Margin="0,22,0,0"
                    HorizontalAlignment="Center" Click="OnUnlock" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
